                    @if (_pvInfo.Hosts.Count == 0)
                    {
                        <p class="muted small">@L["هیچ آدرس کاملی در آن نیست؛ فقط به آدرس پایه‌ای که خودتان وارد می‌کنید درخواست می‌رود."]</p>
                    }
                    else
                    {
                        <ul dir="ltr">
                            @foreach (var h in _pvInfo.Hosts)
                            {
                                <li>@h</li>
                            }
                        </ul>
