@inherits StateComponent

<div class="modal-backdrop" @onclick="State.CloseSettings">
    <div class="modal settings" @onclick:stopPropagation="true">

        <div class="modal-head">
            @if (State.IsNarrow && Section != null)
            {
                <button class="icon-btn" title="@L["بازگشت"]" @onclick="Back">
                    <svg class="flip-rtl" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 6-6 6 6 6" /></svg>
                </button>
            }
            <h2>@Title</h2>
            <button class="icon-btn" title="@L["بستن"]" @onclick="State.CloseSettings">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18" /></svg>
            </button>
        </div>

        <div class="s-layout">

            @if (!State.IsNarrow || Section == null)
            {
                <nav class="s-nav">
                    @foreach (var item in Sections)
                    {
                        var key = item.Key;
                        <button class="s-nav-item @(Section == key ? "active" : "")" @onclick="() => State.SetSettingsSection(key)">
                            <span>@item.Title</span>
                            @if (State.IsNarrow)
                            {
                                <svg class="flip-rtl" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6" /></svg>
                            }
                        </button>
                    }
                </nav>
            }

            @if (Section != null)
            {
                <div class="s-content">
                    @switch (Section)
                    {
                        case "general":
                            <label class="lbl first">@L["زبان برنامه"]</label>
                            <select class="inp" value="@State.Language" @onchange="OnLanguageChanged">
                                <option value="fa">فارسی</option>
                                <option value="en">English</option>
                            </select>

                            <label class="lbl">@L["تم برنامه"]</label>
                            <select class="inp" value="@State.Theme" @onchange="OnThemeChanged">
                                <option value="system">@L["مطابق سیستم"]</option>
                                <option value="dark">@L["تاریک"]</option>
                                <option value="light">@L["روشن"]</option>
                            </select>

                            <label class="check" style="margin-top:18px">
                                <input type="checkbox" checked="@State.IsRtl" @onchange="OnRtlChanged" />
                                <span>@L["رابط راست‌به‌چپ (فارسی)"]</span>
                            </label>
                            break;

                        case "appearance":
                            <label class="lbl first">@L["اندازه‌ی متن"]: @State.UiFontSize px</label>
                            <input type="range" class="range" min="12" max="26" step="1" value="@State.UiFontSize" @oninput="e => State.SetUi(fontSize: ToInt(e))" />

                            <label class="lbl">@L["عرض خطوط (عرض محتوا)"]: @(State.UiWidth == 0 ? L["تمام‌عرض"] : State.UiWidth + " px")</label>
                            <input type="range" class="range" min="480" max="1400" step="20" value="@(State.UiWidth == 0 ? 1400 : State.UiWidth)" @oninput="e => State.SetUi(width: ToInt(e))" />
                            <label class="check" style="margin-top:8px">
                                <input type="checkbox" checked="@(State.UiWidth == 0)" @onchange="OnFullWidth" />
                                <span>@L["تمام‌عرض"]</span>
                            </label>

                            <label class="lbl">@L["فاصله‌ی خطوط"]: @(State.UiLineHeight / 100.0) </label>
                            <input type="range" class="range" min="120" max="220" step="5" value="@State.UiLineHeight" @oninput="e => State.SetUi(lineHeight: ToInt(e))" />

                            <label class="lbl">@L["قلم"]</label>
                            <select class="inp" value="@State.UiFont" @onchange="OnFontChanged">
                                <option value="default">@L["پیش‌فرض"]</option>
                                <option value="tahoma">Tahoma</option>
                                <option value="serif">@L["سریف"]</option>
                                <option value="mono">@L["تک‌فاصله"]</option>
                            </select>

                            <button class="btn" style="margin-top:20px" @onclick="State.ResetUi">@L["بازنشانی ظاهر"]</button>
                            break;

                        case "api":
                            <div class="chips">
                                @foreach (var p in State.Providers)
                                {
                                    var prov = p;
                                    <button class="pill @(_editing?.Id == prov.Id && !_isNew ? "active" : "")" dir="auto" @onclick="() => Edit(prov)">@prov.Name</button>
                                }
                                <button class="pill add @(_isNew ? "active" : "")" @onclick="StartNew">@L["+ افزودن API"]</button>
                            </div>

                            @if (_editing == null)
                            {
                                <p class="muted">@L["یک API را انتخاب کنید یا مورد جدیدی اضافه کنید."]</p>
                            }
                            else
                            {
                                <label class="lbl">@L["الگوی آماده"]</label>
                                <select class="inp" @onchange="OnPreset">
                                    <option value="">@L["— انتخاب کنید (اختیاری) —"]</option>
                                    @foreach (var pr in ProviderDefaults.Presets)
                                    {
                                        <option value="@pr.Name">@L[pr.Name]</option>
                                    }
                                </select>

                                <label class="lbl">@L["نام نمایشی"]</label>
                                <input class="inp" dir="auto" @bind="_editing.Name" @bind:event="oninput" />

                                <label class="lbl">@L["نوع API"]</label>
                                <select class="inp" @bind="_editing.Type" @bind:after="OnTypeChanged">
                                    @foreach (var t in Enum.GetValues<ProviderType>())
                                    {
                                        <option value="@t">@L[ProviderDefaults.TypeLabel(t)]</option>
                                    }
                                </select>

                                <label class="lbl">@L["آدرس پایه (Base URL)"]</label>
                                <input class="inp" dir="ltr" autocapitalize="off" spellcheck="false" @bind="_editing.BaseUrl" @bind:event="oninput" />

                                <label class="lbl">@L["کلید API"]</label>
                                <div class="row">
                                    <input class="inp" dir="ltr" autocomplete="off" autocapitalize="off" spellcheck="false"
                                           type="@(_showKey ? "text" : "password")" @bind="_editing.ApiKey" @bind:event="oninput" />
                                    <button class="btn" type="button" @onclick="() => _showKey = !_showKey">@(_showKey ? L["پنهان"] : L["نمایش"])</button>
                                </div>

                                <label class="lbl">@L["مدل‌ها (هر خط یک مدل)"]</label>
                                <textarea class="inp" rows="6" dir="ltr" autocapitalize="off" spellcheck="false" @bind="_modelsText" @bind:event="oninput"></textarea>

                                <div class="row">
                                    <button class="btn" disabled="@_busy" @onclick="FetchModels">@L["دریافت خودکار لیست مدل‌ها"]</button>
                                </div>

                                <label class="lbl">@L["مدل پیش‌فرض"]</label>
                                <input class="inp" dir="ltr" autocapitalize="off" spellcheck="false" @bind="_editing.DefaultModel" @bind:event="oninput" />

                                @if (_status != null)
                                {
                                    <p class="status" dir="auto">@_status</p>
                                }

                                <div class="row end">
                                    @if (!_isNew)
                                    {
                                        @if (_confirmDelete)
                                        {
                                            <button class="btn danger" @onclick="DeleteProvider">@L["حذف قطعی"]</button>
                                        }
                                        else
                                        {
                                            <button class="btn" @onclick="() => _confirmDelete = true">@L["حذف"]</button>
                                        }
                                    }
                                    <button class="primary" @onclick="Save">@L["ذخیره"]</button>
                                </div>
                            }
                            break;

                        case "chat":
                            <label class="lbl first">@L["پیام سیستمی (اختیاری، برای همه مدل‌ها)"]</label>
                            <textarea class="inp" rows="6" dir="auto" placeholder="@L["مثلاً: همیشه به فارسی پاسخ بده."]"
                                      value="@State.SystemPrompt" @oninput="OnSystemPromptInput"></textarea>
                            <p class="muted small" style="margin-top:8px">@L["دستورالعمل‌های هر پروژه به این پیام اضافه می‌شود."]</p>
                            break;

                        case "data":
                            <label class="lbl first">@L["لاگ برنامه"]</label>
                            <p class="muted small">@L["اگر برنامه خطا داد، لاگ را کپی کنید و بفرستید. کلید API و متن پیام‌ها در لاگ نمی‌آید."]</p>
                            <button class="btn" @onclick="State.OpenLogs">@L["مشاهده لاگ‌ها"]</button>

                            <label class="lbl">@L["گفتگوها"]</label>
                            @if (_confirmClear)
                            {
                                <button class="btn danger" @onclick="ClearAll">@L["مطمئنید؟ همه گفتگوها پاک می‌شود"]</button>
                            }
                            else
                            {
                                <button class="btn" @onclick="() => _confirmClear = true">@L["پاک کردن همه گفتگوها"]</button>
                            }
                            break;

                        case "about":
                            <label class="lbl first">AI Chat</label>
                            <p>@L["نسخه"] @AppInfo.Current.VersionString</p>
                            <p class="muted small">@L["چت چندسرویسی با پشتیبانی از OpenAI-compatible، Claude و Gemini."]</p>
                            break;
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    record SectionItem(string Key, string Title);

    SectionItem[] Sections => new[]
    {
        new SectionItem("general", L["عمومی"]),
        new SectionItem("appearance", L["ظاهر"]),
        new SectionItem("api", L["API ها"]),
        new SectionItem("chat", L["گفتگو"]),
        new SectionItem("data", L["داده‌ها و لاگ"]),
        new SectionItem("about", L["درباره"])
    };

    // on a wide window a section is always selected; on a phone null = the list of sections
    string? Section => State.SettingsSection ?? (State.IsNarrow ? null : "general");

    string Title => Section == null
        ? L["تنظیمات"]
        : Sections.First(x => x.Key == Section).Title;

    void Back() => State.SetSettingsSection(null);

    // ---------------- general / chat / data

    void OnSystemPromptInput(ChangeEventArgs e) => State.SetSystemPrompt(e.Value?.ToString() ?? string.Empty);

    void OnRtlChanged(ChangeEventArgs e) => State.SetRtl(e.Value is true);

    static int ToInt(ChangeEventArgs e) => int.TryParse(e.Value?.ToString(), out var v) ? v : 0;
    void OnFullWidth(ChangeEventArgs e) => State.SetUi(width: e.Value is true ? 0 : 768);
    void OnFontChanged(ChangeEventArgs e) => State.SetUi(font: e.Value?.ToString() ?? "default");

    void OnLanguageChanged(ChangeEventArgs e) => State.SetLanguage(e.Value?.ToString() ?? "fa");

    void OnThemeChanged(ChangeEventArgs e) => State.SetTheme(e.Value?.ToString() ?? "system");

    bool _confirmClear;

    async Task ClearAll()
    {
        _confirmClear = false;
        await State.ClearAllConversationsAsync();
    }

    // ---------------- API providers

    ProviderConfig? _editing;
    bool _isNew;
    string _modelsText = "";
    bool _showKey;
    bool _busy;
    bool _confirmDelete;
    string? _status;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (State.Providers.Count == 0) StartNew();
        else Edit(State.CurrentProvider ?? State.Providers[0]);
    }

    void Edit(ProviderConfig p)
    {
        _editing = p.Clone();
        _isNew = false;
        _modelsText = string.Join("\n", p.Models);
        _status = null;
        _showKey = false;
        _confirmDelete = false;
    }

    void StartNew()
    {
        _editing = new ProviderConfig
        {
            Name = "OpenAI",
            Type = ProviderType.OpenAiCompatible,
            BaseUrl = ProviderDefaults.BaseUrl(ProviderType.OpenAiCompatible)
        };
        _isNew = true;
        _modelsText = "";
        _status = null;
        _showKey = false;
        _confirmDelete = false;
    }

    void OnPreset(ChangeEventArgs e)
    {
        var preset = ProviderDefaults.Presets.FirstOrDefault(p => p.Name == e.Value?.ToString());
        if (preset == null || _editing == null) return;
        _editing.Name = L[preset.Name];
        _editing.Type = preset.Type;
        _editing.BaseUrl = preset.BaseUrl;
    }

    void OnTypeChanged()
    {
        if (_editing == null) return;
        // switching type: if the URL is still one of the known defaults, swap it for the new type's default
        var known = ProviderDefaults.Presets.Select(p => p.BaseUrl)
            .Concat(new[] { "https://api.openai.com/v1", "https://api.anthropic.com/v1", "https://generativelanguage.googleapis.com/v1beta" });
        if (string.IsNullOrWhiteSpace(_editing.BaseUrl) || known.Contains(_editing.BaseUrl.Trim()))
            _editing.BaseUrl = ProviderDefaults.BaseUrl(_editing.Type);
    }

    async Task FetchModels()
    {
        if (_editing == null) return;
        if (string.IsNullOrWhiteSpace(_editing.BaseUrl))
            _editing.BaseUrl = ProviderDefaults.BaseUrl(_editing.Type);

        _busy = true;
        _status = L["در حال دریافت..."];
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
            var list = await State.FetchModelsAsync(_editing, cts.Token);
            _modelsText = string.Join("\n", list);
            if (string.IsNullOrWhiteSpace(_editing.DefaultModel) && list.Count > 0)
                _editing.DefaultModel = list[0];
            _status = L.F("{0} مدل دریافت شد. برای نگه‌داشتن، ذخیره را بزنید.", list.Count);
        }
        catch (Exception ex)
        {
            _status = L["خطا: "] + ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    async Task Save()
    {
        if (_editing == null) return;
        if (string.IsNullOrWhiteSpace(_editing.Name))
        {
            _status = L["نام را وارد کنید."];
            return;
        }

        _editing.Name = _editing.Name.Trim();
        _editing.ApiKey = (_editing.ApiKey ?? "").Trim();
        _editing.DefaultModel = (_editing.DefaultModel ?? "").Trim();
        if (string.IsNullOrWhiteSpace(_editing.BaseUrl))
            _editing.BaseUrl = ProviderDefaults.BaseUrl(_editing.Type);
        _editing.BaseUrl = _editing.BaseUrl.Trim();

        _editing.Models = _modelsText
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct()
            .ToList();
        if (string.IsNullOrWhiteSpace(_editing.DefaultModel) && _editing.Models.Count > 0)
            _editing.DefaultModel = _editing.Models[0];

        await State.SaveProviderAsync(_editing);
        _isNew = false;
        _status = L["ذخیره شد ✓"];
    }

    async Task DeleteProvider()
    {
        if (_editing == null) return;
        await State.DeleteProviderAsync(_editing.Id);
        _confirmDelete = false;
        if (State.Providers.Count == 0) StartNew();
        else Edit(State.Providers[0]);
    }
}
