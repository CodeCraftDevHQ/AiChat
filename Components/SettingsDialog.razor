                    <p class="muted small">@L["هشدار: اتصال‌ها می‌توانند پیام‌ها، فایل‌ها و کلید API شما را به آدرس‌های داخلشان بفرستند. فقط از منبع قابل‌اعتماد استفاده کنید."]</p>
                    <textarea class="inp code" rows="10" dir="ltr" readonly>@_pvJson</textarea>
                    <div class="row">
                        <button class="primary" type="button" @onclick="UsePreview">@L["استفاده"]</button>
                        <button class="btn" type="button" @onclick="() => { _pvJson = null; _pvInfo = null; }">@L["بازگشت"]</button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    int _dlg = -1;

    // connector from a URL / catalog
    string _repoUrl = "";
    string? _repoStatus, _pvJson;
    ConnectorInfo? _pvInfo;
    List<CatalogItem> _catalog = new();
    bool _repoBusy;

    async Task LoadCatalog()
    {
        _repoBusy = true;
        _repoStatus = L["در حال دریافت..."];
        StateHasChanged();
        try
        {
            var text = await State.FetchConnectorTextAsync(State.ConnectorCatalogUrl);
            _catalog = ConnectorRepo.ParseCatalog(text, State.ConnectorCatalogUrl);
            _repoStatus = _catalog.Count == 0 ? L["فهرست خالی است."] : null;
        }
        catch (Exception ex) { _repoStatus = L["خطا: "] + ex.Message; }
        _repoBusy = false;
    }

    async Task FetchPreview(string url)
    {
        if (string.IsNullOrWhiteSpace(url)) return;
        _repoBusy = true;
        _repoStatus = L["در حال دریافت..."];
        StateHasChanged();
        try
        {
            var json = await State.FetchConnectorTextAsync(url);
            var info = ConnectorRepo.Inspect(json, out var err);
            if (info == null) _repoStatus = L["این فایل یک اتصال معتبر نیست: "] + err;
            else { _pvJson = json; _pvInfo = info; _repoStatus = null; }
        }
        catch (Exception ex) { _repoStatus = L["خطا: "] + ex.Message; }
        _repoBusy = false;
    }

    void UsePreview()
    {
        if (_editing == null || _pvJson == null || _pvInfo == null) return;
        _editing.ConnectorJson = _pvJson.Trim();
        _editing.ConnectorInputs = new();
        if (_pvInfo.BaseUrl.Length > 0) _editing.BaseUrl = _pvInfo.BaseUrl;
        if (_pvInfo.Name.Length > 0 && (_isNew || string.IsNullOrWhiteSpace(_editing.Name) || _editing.Name == "OpenAI")) _editing.Name = _pvInfo.Name;
        _modelsText = "";
        _status = L["اتصال بارگذاری شد؛ در صورت نیاز آدرس و کلید را تنظیم کنید."];
        _pvJson = null;
        _pvInfo = null;
        CloseDlg();
    }
    bool _promptCopied;

    void OpenDlg(int which)
    {
        _dlg = which;
        _promptCopied = false;
        State.PushBack(CloseDlgFromBack);
    }

    void CloseDlgFromBack()
    {
        _dlg = -1;
        InvokeAsync(StateHasChanged);
    }

    void CloseDlg()
    {
        _dlg = -1;
        State.RemoveBack(CloseDlgFromBack);
    }

    void UsePreset(string name)
    {
        OnPresetChosen("user:" + name);
        CloseDlg();
    }

    async Task CopyPrompt()
    {
        await Clipboard.Default.SetTextAsync(ConnectorGuide.AiPrompt);
        _promptCopied = true;
    }

    /// <summary>The "_help" sentence of the connector in the editor (templates describe themselves there).</summary>
    string ConnectorHelp() =>
        _editing != null && ConnectorSpec.TryParse(_editing.ConnectorJson, out _) is { } o ? JPath.Text(o["_help"]) : "";

    record SectionItem(string Key, string Title);

    SectionItem[] Sections => new[]
    {
        new SectionItem("general", L["عمومی"]),
        new SectionItem("appearance", L["ظاهر"]),
        new SectionItem("api", L["API ها"]),
        new SectionItem("chat", L["گفتگو"]),
        new SectionItem("answer", L["پاسخ مدل"]),
        new SectionItem("search", L["جستجو در وب"]),
        new SectionItem("memory", L["حافظه"]),
        new SectionItem("summary", L["خلاصه‌سازی گفتگو"]),
        new SectionItem("personas", L["شخصیت‌ها"]),
        new SectionItem("prompts", L["کتابخانه‌ی پرامپت"]),
        new SectionItem("tools", L["ابزارها"]),
        new SectionItem("mcp", L["سرورهای MCP"]),
        new SectionItem("cost", L["توکن و هزینه"]),
        new SectionItem("security", L["امنیت و حریم خصوصی"]),
        new SectionItem("data", L["داده‌ها و لاگ"]),
        new SectionItem("about", L["درباره"])
    };

    // on a wide window a section is always selected; on a phone null = the list of sections
    string? Section => State.SettingsSection ?? (State.IsNarrow ? null : "general");

    string Title => Section == null
        ? L["تنظیمات"]
        : Sections.First(x => x.Key == Section).Title;

    void Back() => State.SetSettingsSection(null);

    // ---------------- general / chat / data

    void OnSystemPromptInput(ChangeEventArgs e) => State.SetSystemPrompt(e.Value?.ToString() ?? string.Empty);

    void OnRtlChanged(ChangeEventArgs e) => State.SetRtl(e.Value is true);

    static int ToInt(ChangeEventArgs e) => int.TryParse(e.Value?.ToString(), out var v) ? v : 0;
    void OnFullWidth(ChangeEventArgs e) => State.SetUi(width: e.Value is true ? 0 : 768);



    string? _searchStatus;

    void Cost(Action<CostOptions> set)
    {
        set(State.CostOpts);
        State.SaveCostOpts();
    }

    static double ToDouble(ChangeEventArgs e, double fallback) =>
        double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : fallback;

    void ToolOpt(Action<ToolOptions> set)
    {
        set(State.ToolOpts);
        State.SaveToolOpts();
    }

    void Opt(Action<SearchOptions> set)
    {
        set(State.SearchOpts);
        State.SaveSearchOpts();
    }

    void ResetSearchOpts()
    {
        State.ResetSearchOpts();
        _searchStatus = null;
    }

    async Task TestSearch()
    {
        _searchStatus = L["در حال آزمایش..."];
        StateHasChanged();
        _searchStatus = await State.TestSearchAsync();
    }

    string _pinNew = "", _pinRep = "";
    string? _pinStatus;

    void SetPin()
    {
        _pinStatus = State.SetPin(_pinNew, _pinRep) ?? L["قفل فعال شد ✓"];
        if (State.HasPin) { _pinNew = ""; _pinRep = ""; }
    }

    void RemovePin()
    {
        if (State.RemovePin(_pinNew)) { _pinStatus = L["قفل برداشته شد."]; _pinNew = ""; }
        else _pinStatus = L["رمز اشتباه است."];
    }

    bool _bkKeys, _bkRestore;
    string? _bkStatus;

    async Task MakeBackup()
    {
        _bkStatus = null;
        await State.CreateBackupAsync(_bkKeys);
    }

    async Task RestoreBackup()
    {
        _bkRestore = false;
        try
        {
            var file = await FilePicker.Default.PickAsync(new PickOptions { PickerTitle = L["انتخاب فایل نسخه پشتیبان"] });
            if (file == null) return;
            await using var stream = await file.OpenReadAsync();
            var err = await State.RestoreBackupAsync(stream);
            _bkStatus = err ?? L["بازیابی انجام شد ✓"];
        }
        catch (Exception ex) { _bkStatus = L["خطا: "] + ex.Message; }
    }

    bool _confirmClear;

    async Task ClearAll()
    {
        _confirmClear = false;
        await State.ClearAllConversationsAsync();
    }

    // ---------------- API providers

    ProviderConfig? _editing;
    bool _isNew;
    string _modelsText = "";
    bool _showKey;
    bool _busy;
    bool _confirmDelete;
    string? _status;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (State.EditProviderId != null)
        {
            var wanted = State.Providers.FirstOrDefault(p => p.Id == State.EditProviderId);
            State.EditProviderId = null;
            if (wanted != null) Edit(wanted); else StartNew();
        }
        else if (State.NewApiRequested) { State.NewApiRequested = false; StartNew(); }
        else if (State.Providers.Count == 0) StartNew();
        else Edit(State.CurrentProvider ?? State.Providers[0]);
    }

    void Edit(ProviderConfig p)
    {
        _editing = p.Clone();
        _isNew = false;
        _modelsText = string.Join("\n", p.Models);
        _status = null;
        _showKey = false;
        _confirmDelete = false;
    }

    void StartNew()
    {
        _editing = new ProviderConfig
        {
            Name = "OpenAI",
            Type = ProviderType.OpenAiCompatible,
            BaseUrl = ProviderDefaults.BaseUrl(ProviderType.OpenAiCompatible)
        };
        _isNew = true;
        _modelsText = "";
        _status = null;
        _showKey = false;
        _confirmDelete = false;
    }

    static readonly string[] AspectRatios =
    {
        "704*1408", "704*1344", "768*1344", "768*1280", "832*1216", "832*1152", "896*1152", "896*1088", "960*1088", "960*1024",
        "1024*1024", "1024*960", "1088*960", "1088*896", "1152*896", "1152*832", "1216*832", "1280*768", "1344*768", "1344*704",
        "1408*704", "1472*704", "1536*640", "1600*640", "1664*576", "1728*576"
    };

    void OnFontChosen(string v) => State.SetUi(font: v);

    void OnTypeChosen(string v)
    {
        if (_editing == null || !Enum.TryParse<ProviderType>(v, out var t)) return;
        _editing.Type = t;
        OnTypeChanged();
    }

    List<AppSelect.SelectOption> PresetOptions() =>
        State.UserPresets.Select(u => new AppSelect.SelectOption("user:" + u.Name, "★ " + u.Name))
            .Concat(ProviderDefaults.Presets.Select(pr => new AppSelect.SelectOption(pr.Name, L[pr.Name])))
            .ToList();

    async Task SaveAsPreset()
    {
        if (_editing == null) return;
        if (string.IsNullOrWhiteSpace(_editing.Name)) { _status = L["اول یک نام برای این API بنویسید."]; return; }
        ApplyModelsText();
        await State.SaveUserPresetAsync(_editing, _editing.Name);
        _status = L["الگو ذخیره شد ✓"];
    }

    void ApplyModelsText() =>
        _editing!.Models = _modelsText.Split('\n').Select(x => x.Trim()).Where(x => x.Length > 0).Distinct().ToList();

    void OnPresetChosen(string name)
    {
        if (name.StartsWith("user:") && _editing != null)
        {
            var up = State.UserPresets.FirstOrDefault(u => u.Name == name[5..]);
            if (up == null) return;
            var c = up.Clone();
            c.Id = _editing.Id;
            c.ApiKey = _editing.ApiKey;
            _editing = c;
            _modelsText = string.Join("\n", c.Models);
            _status = L["الگو بارگذاری شد؛ در صورت نیاز آدرس و کلید را تنظیم کنید."];
            return;
        }
        var preset = ProviderDefaults.Presets.FirstOrDefault(p => p.Name == name);
        if (preset == null || _editing == null) return;
        _editing.Name = L[preset.Name];
        _editing.Type = preset.Type;
        _editing.BaseUrl = preset.BaseUrl;
    }

    void OnTypeChanged()
    {
        if (_editing == null) return;
        // switching type: if the URL is still one of the known defaults, swap it for the new type's default
        var known = ProviderDefaults.Presets.Select(p => p.BaseUrl)
            .Concat(new[] { "https://api.openai.com/v1", "https://api.anthropic.com/v1", "https://generativelanguage.googleapis.com/v1beta" });
        if (string.IsNullOrWhiteSpace(_editing.BaseUrl) || known.Contains(_editing.BaseUrl.Trim()))
            _editing.BaseUrl = ProviderDefaults.BaseUrl(_editing.Type);
    }

    bool _advOpen;

    static string Inv(double d) => d.ToString(System.Globalization.CultureInfo.InvariantCulture);

    RenderFragment<ConnInput> InputField => inp => @<div>
        @if (inp.Type == "select" && inp.Options.Count > 0)
        {
            <AppSelect Title="@L[inp.Label]" Value="@InputOf(inp.Id, inp.Default)" ValueChanged="v => _editing!.ConnectorInputs[inp.Id] = v"
                       Options="@(inp.Options.Select(o => new AppSelect.SelectOption(o, o)).ToList())" />
        }
        else if (inp.Type == "bool")
        {
            <label class="chk"><input type="checkbox" checked="@(InputOf(inp.Id, inp.Default).Equals("true", StringComparison.OrdinalIgnoreCase))"
                                      @onchange="e => _editing!.ConnectorInputs[inp.Id] = ((bool)(e.Value ?? false)).ToString().ToLowerInvariant()" /> @L[inp.Label]</label>
        }
        else if (inp.Type == "slider")
        {
            <div class="slider-row">
                <input type="range" class="range" min="@Inv(inp.Min ?? 0)" max="@Inv(inp.Max ?? 1)" step="@Inv(inp.Step ?? 0.1)"
                       value="@InputOf(inp.Id, inp.Default)" @oninput="e => _editing!.ConnectorInputs[inp.Id] = e.Value?.ToString() ?? string.Empty" />
                <span class="muted val" dir="ltr">@InputOf(inp.Id, inp.Default)</span>
            </div>
        }
        else
        {
            <input class="inp" dir="auto" type="@(inp.Type == "number" ? "number" : "text")" step="any"
                   value="@InputOf(inp.Id, inp.Default)" @oninput="e => _editing!.ConnectorInputs[inp.Id] = e.Value?.ToString() ?? string.Empty" />
        }
    </div>;

    void InsertControlsSample()
    {
        if (_editing == null) return;
        _editing.Controls = "[\n" +
            "  { \"id\": \"temperature\", \"label\": \"Temperature\", \"type\": \"slider\", \"min\": 0, \"max\": 2, \"step\": 0.1, \"default\": \"0.7\" },\n" +
            "  { \"id\": \"max_tokens\", \"label\": \"Max tokens\", \"type\": \"number\", \"default\": \"1024\" }\n" +
            "]";
        if (string.IsNullOrWhiteSpace(_editing.ExtraBody))
            _editing.ExtraBody = "{ \"temperature\": \"{{input.temperature}}\", \"max_tokens\": \"{{input.max_tokens}}\" }";
        _advOpen = true;
    }

    string InputOf(string id, string def) => _editing != null && _editing.ConnectorInputs.TryGetValue(id, out var v) ? v : def;

    void OnTemplateChosen(string name)
    {
        var t = ConnectorTemplates.All.FirstOrDefault(x => x.Name == name);
        if (t == null || _editing == null) return;
        _editing.ConnectorJson = t.Json.Trim();
        _editing.ConnectorInputs = new();
        _editing.BaseUrl = t.BaseUrl;
        if (_isNew || string.IsNullOrWhiteSpace(_editing.Name) || _editing.Name == "OpenAI") _editing.Name = L[t.Name];
        _modelsText = "";
        _status = L["الگو بارگذاری شد؛ در صورت نیاز آدرس و کلید را تنظیم کنید."];
    }

    void CheckConnector()
    {
        if (_editing == null) return;
        var err = ConnectorSpec.Validate(_editing.ConnectorJson);
        _status = err == null ? L["اتصال معتبر به نظر می‌رسد ✓"] : L["خطا در اتصال: "] + err;
    }

    async Task ImportConnector()
    {
        if (_editing == null) return;
        try
        {
            var file = await FilePicker.Default.PickAsync(new PickOptions { PickerTitle = L["انتخاب فایل JSON اتصال"] });
            if (file == null) return;
            await using var stream = await file.OpenReadAsync();
            using var reader = new StreamReader(stream);
            _editing.ConnectorJson = await reader.ReadToEndAsync();
            _editing.ConnectorInputs = new();
            CheckConnector();
        }
        catch (Exception ex)
        {
            _status = L["خطا: "] + ex.Message;
        }
    }

    Task ExportConnector()
    {
        if (_editing == null) return Task.CompletedTask;
        var name = string.Concat((_editing.Name ?? "connector").Select(c => char.IsLetterOrDigit(c) ? c : '-')).Trim('-');
        return State.SaveTextAsync((name.Length == 0 ? "connector" : name) + ".json", _editing.ConnectorJson ?? "");
    }

    static readonly (string Key, string Label)[] AuthModes =
    {
        ("default", "پیش‌فرض (بر اساس نوع API)"),
        ("bearer", "Bearer در هدر Authorization"),
        ("header", "هدر دلخواه"),
        ("query", "پارامتر در آدرس (query)"),
        ("none", "بدون کلید"),
    };

    string? ValidateAdvanced()
    {
        if (_editing == null) return null;
        try
        {
            if (!string.IsNullOrWhiteSpace(_editing.ExtraBody) &&
                System.Text.Json.Nodes.JsonNode.Parse(_editing.ExtraBody) is not System.Text.Json.Nodes.JsonObject)
                return L["پارامترهای اضافی باید یک شیء JSON باشد."];
        }
        catch (Exception ex)
        {
            return L["JSON پارامترهای اضافی نامعتبر است: "] + ex.Message;
        }
        try
        {
            if (!string.IsNullOrWhiteSpace(_editing.Controls) &&
                System.Text.Json.Nodes.JsonNode.Parse(_editing.Controls) is not System.Text.Json.Nodes.JsonArray)
                return L["کنترل‌ها باید یک آرایه‌ی JSON باشد."];
        }
        catch (Exception ex)
        {
            return L["JSON کنترل‌ها نامعتبر است: "] + ex.Message;
        }
        try { ProviderHttp.ParseHeaders(_editing.Headers ?? "", "x"); }
        catch (Exception ex) { return L["هدرها نامعتبر است: "] + ex.Message; }
        if (_editing.AuthMode is "header" or "query" && string.IsNullOrWhiteSpace(_editing.AuthName))
            return L["نام هدر یا پارامتر کلید را وارد کنید."];
        return null;
    }

    Task FetchModels() => TryFetch();

    async Task<bool> TryFetch()
    {
        if (_editing == null) return false;
        if (string.IsNullOrWhiteSpace(_editing.BaseUrl))
            _editing.BaseUrl = ProviderDefaults.BaseUrl(_editing.Type);

        _busy = true;
        _status = L["در حال دریافت..."];
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
            var list = await State.FetchModelsAsync(_editing, cts.Token);
            _modelsText = string.Join("\n", list);
            if (string.IsNullOrWhiteSpace(_editing.DefaultModel) && list.Count > 0)
                _editing.DefaultModel = list[0];
            _status = L.F("{0} مدل دریافت شد. برای نگه‌داشتن، ذخیره را بزنید.", list.Count);
            return list.Count > 0;
        }
        catch (Exception ex)
        {
            _status = L["خطا: "] + ProviderHttp.Describe(ex);
            return false;
        }
        finally
        {
            _busy = false;
        }
    }

    async Task Save()
    {
        if (_editing == null) return;
        if (string.IsNullOrWhiteSpace(_editing.Name))
        {
            _status = L["نام را وارد کنید."];
            return;
        }

        if (_editing.Type == ProviderType.Custom && ConnectorSpec.Validate(_editing.ConnectorJson) is { } connErr)
        {
            _status = L["خطا در اتصال: "] + connErr;
            return;
        }
        if (ValidateAdvanced() is { } advErr) { _status = advErr; _advOpen = true; return; }

        _editing.Name = _editing.Name.Trim();
        _editing.ApiKey = (_editing.ApiKey ?? "").Trim();
        _editing.DefaultModel = (_editing.DefaultModel ?? "").Trim();
        if (string.IsNullOrWhiteSpace(_editing.BaseUrl))
            _editing.BaseUrl = ProviderDefaults.BaseUrl(_editing.Type);
        _editing.BaseUrl = _editing.BaseUrl.Trim();

        // no model list yet: fetch it automatically (the manual button stays available)
        var autoFetched = false;
        string? fetchError = null;
        if (string.IsNullOrWhiteSpace(_modelsText))
        {
            autoFetched = await TryFetch();
            if (!autoFetched) fetchError = _status;
        }

        _editing.Models = _modelsText
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct()
            .ToList();
        if (string.IsNullOrWhiteSpace(_editing.DefaultModel) && _editing.Models.Count > 0)
            _editing.DefaultModel = _editing.Models[0];

        await State.SaveProviderAsync(_editing);
        _isNew = false;
        _status = L["ذخیره شد ✓"];
        if (autoFetched) _status += " · " + L.F("{0} مدل دریافت شد.", _editing.Models.Count);
        else if (fetchError != null) _status += " · " + L["دریافت خودکار مدل‌ها ناموفق بود"] + " (" + fetchError + ")";
    }

    async Task DeleteProvider()
    {
        if (_editing == null) return;
        await State.DeleteProviderAsync(_editing.Id);
        _confirmDelete = false;
        if (State.Providers.Count == 0) StartNew();
        else Edit(State.Providers[0]);
    }
}
