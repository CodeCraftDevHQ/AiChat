@inherits StateComponent

<div class="modal-backdrop" @onclick="State.CloseSettings">
    <div class="modal settings" @onclick:stopPropagation="true">

        <div class="modal-head">
            @if (State.IsNarrow && Section != null)
            {
                <button class="icon-btn" title="@L["بازگشت"]" @onclick="Back">
                    <svg class="flip-rtl" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 6-6 6 6 6" /></svg>
                </button>
            }
            <h2>@Title</h2>
            <button class="icon-btn" title="@L["بستن"]" @onclick="State.CloseSettings">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18" /></svg>
            </button>
        </div>

        <div class="s-layout">

            @if (!State.IsNarrow || Section == null)
            {
                <nav class="s-nav">
                    @foreach (var item in Sections)
                    {
                        var key = item.Key;
                        <button class="s-nav-item @(Section == key ? "active" : "")" @onclick="() => State.SetSettingsSection(key)">
                            <span>@item.Title</span>
                            @if (State.IsNarrow)
                            {
                                <svg class="flip-rtl" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6" /></svg>
                            }
                        </button>
                    }
                </nav>
            }

            @if (Section != null)
            {
                <div class="s-content">
                    @switch (Section)
                    {
                        case "general":
                            <label class="lbl first">@L["زبان برنامه"]</label>
                            <AppSelect Title="@L["زبان برنامه"]" Value="@State.Language" ValueChanged="State.SetLanguage"
                                       Options="@(new AppSelect.SelectOption[] { new("fa", "فارسی"), new("en", "English") })" />

                            <label class="lbl">@L["تم برنامه"]</label>
                            <AppSelect Title="@L["تم برنامه"]" Value="@State.Theme" ValueChanged="State.SetTheme"
                                       Options="@(new AppSelect.SelectOption[] { new("system", L["مطابق سیستم"]), new("dark", L["تاریک"]), new("light", L["روشن"]) })" />

                            <label class="check" style="margin-top:18px">
                                <input type="checkbox" checked="@State.IsRtl" @onchange="OnRtlChanged" />
                                <span>@L["رابط راست‌به‌چپ (فارسی)"]</span>
                            </label>
                            break;

                        case "appearance":
                            <label class="lbl first">@L["اندازه‌ی متن"]: @State.UiFontSize px</label>
                            <input type="range" class="range" min="12" max="26" step="1" value="@State.UiFontSize" @oninput="e => State.SetUi(fontSize: ToInt(e))" />

                            <label class="lbl">@L["عرض خطوط (عرض محتوا)"]: @(State.UiWidth == 0 ? L["تمام‌عرض"] : State.UiWidth + " px")</label>
                            <input type="range" class="range" min="480" max="1400" step="20" value="@(State.UiWidth == 0 ? 1400 : State.UiWidth)" @oninput="e => State.SetUi(width: ToInt(e))" />
                            <label class="check" style="margin-top:8px">
                                <input type="checkbox" checked="@(State.UiWidth == 0)" @onchange="OnFullWidth" />
                                <span>@L["تمام‌عرض"]</span>
                            </label>

                            <label class="lbl">@L["فاصله‌ی خطوط"]: @(State.UiLineHeight / 100.0) </label>
                            <input type="range" class="range" min="120" max="220" step="5" value="@State.UiLineHeight" @oninput="e => State.SetUi(lineHeight: ToInt(e))" />

                            <label class="lbl">@L["قلم"]</label>
                            <AppSelect Title="@L["قلم"]" Value="@State.UiFont" ValueChanged="OnFontChosen"
                                       Options="@(new AppSelect.SelectOption[] { new("default", L["پیش‌فرض"]), new("tahoma", "Tahoma"), new("serif", L["سریف"]), new("mono", L["تک‌فاصله"]) })" />

                            <button class="btn" style="margin-top:20px" @onclick="State.ResetUi">@L["بازنشانی ظاهر"]</button>
                            break;

                        case "api":
                            <div class="chips">
                                @foreach (var p in State.Providers)
                                {
                                    var prov = p;
                                    <button class="pill @(_editing?.Id == prov.Id && !_isNew ? "active" : "")" dir="auto" @onclick="() => Edit(prov)">@prov.Name</button>
                                }
                                <button class="pill add @(_isNew ? "active" : "")" @onclick="StartNew">@L["+ افزودن API"]</button>
                            </div>

                            @if (_editing == null)
                            {
                                <p class="muted">@L["یک API را انتخاب کنید یا مورد جدیدی اضافه کنید."]</p>
                            }
                            else
                            {
                                <label class="lbl">@L["الگوی آماده"]</label>
                                <AppSelect Title="@L["الگوی آماده"]" Value="" ValueChanged="OnPresetChosen" Placeholder="@L["— انتخاب کنید (اختیاری) —"]"
                                           Options="@PresetOptions()" />
                                <div class="row">
                                    <button class="btn sm" type="button" @onclick="SaveAsPreset">★ @L["ذخیره به‌عنوان الگو"]</button>
                                    @if (State.UserPresets.Count > 0)
                                    {
                                        <button class="btn sm" type="button" @onclick="() => OpenDlg(0)">@L["مدیریت الگوهای من"] (@State.UserPresets.Count)</button>
                                    }
                                </div>


                                <label class="lbl">@L["نام نمایشی"]</label>
                                <input class="inp" dir="auto" @bind="_editing.Name" @bind:event="oninput" />

                                <label class="lbl">@L["نوع API"]</label>
                                <AppSelect Title="@L["نوع API"]" Value="@_editing.Type.ToString()" ValueChanged="OnTypeChosen"
                                           Options="@(Enum.GetValues<ProviderType>().Select(t => new AppSelect.SelectOption(t.ToString(), L[ProviderDefaults.TypeLabel(t)])).ToList())" />

                                <label class="lbl">@L["آدرس پایه (Base URL)"]</label>
                                <input class="inp" dir="ltr" autocapitalize="off" spellcheck="false" @bind="_editing.BaseUrl" @bind:event="oninput" />

                                <label class="lbl">@L["کلید API"]</label>
                                <div class="row">
                                    <input class="inp" dir="ltr" autocomplete="off" autocapitalize="off" spellcheck="false"
                                           type="@(_showKey ? "text" : "password")" @bind="_editing.ApiKey" @bind:event="oninput" />
                                    <button class="btn" type="button" @onclick="() => _showKey = !_showKey">@(_showKey ? L["پنهان"] : L["نمایش"])</button>
                                </div>

                                @if (_editing.Type == ProviderType.FooocusApi)
                                {
                                    <div class="img-opts">
                                        <label class="lbl">@L["تنظیمات تصویرسازی"]</label>
                                        <p class="muted small">@L["هر پیام یک توضیح تصویر حساب می‌شود. برای نتیجه‌ی بهتر، توضیح را انگلیسی بنویسید."]</p>

                                        <label class="lbl">@L["نسبت تصویر"]</label>
                                        <AppSelect Title="@L["نسبت تصویر"]" Value="@_editing.ImageAspect" ValueChanged="v => _editing.ImageAspect = v"
                                                   Options="@(AspectRatios.Select(a => new AppSelect.SelectOption(a, a.Replace("*", " × "))).ToList())" />

                                        <label class="lbl">@L["سرعت / کیفیت"]</label>
                                        <AppSelect Title="@L["سرعت / کیفیت"]" Value="@_editing.ImagePerformance" ValueChanged="v => _editing.ImagePerformance = v"
                                                   Options="@(new AppSelect.SelectOption[] { new("Speed", "Speed"), new("Quality", "Quality"), new("Extreme Speed", "Extreme Speed") })" />

                                        <label class="lbl">@L["تعداد تصویر در هر پیام"]</label>
                                        <input type="number" class="inp" min="1" max="4" @bind="_editing.ImageCount" @bind:event="onchange" />

                                        <label class="lbl">@L["استایل‌ها (با ویرگول جدا کنید)"]</label>
                                        <input class="inp" dir="ltr" @bind="_editing.ImageStyles" @bind:event="oninput" />

                                        <label class="lbl">@L["متن منفی (چیزهایی که نباید در تصویر باشد)"]</label>
                                        <input class="inp" dir="ltr" @bind="_editing.NegativePrompt" @bind:event="oninput" />
                                    </div>
                                }

                                @if (_editing.Type is not (ProviderType.FooocusApi or ProviderType.Custom))
                                {
                                    <details class="adv" open="@_advOpen" @ontoggle="() => _advOpen = !_advOpen">
                                        <summary>@L["تنظیمات پیشرفته"]</summary>
                                        <p class="muted small">@L["همه‌ی این موارد اختیاری‌اند. برای APIهای غیرمعمول یا سرویس‌های واسط استفاده کنید."]</p>

                                        <label class="lbl">@L["روش ارسال کلید"]</label>
                                        <AppSelect Title="@L["روش ارسال کلید"]" Value="@_editing.AuthMode" ValueChanged="v => _editing.AuthMode = v"
                                                   Options="@(AuthModes.Select(a => new AppSelect.SelectOption(a.Key, L[a.Label])).ToList())" />

                                        @if (_editing.AuthMode is "header" or "query")
                                        {
                                            <label class="lbl">@L["نام هدر یا پارامتر کلید"]</label>
                                            <input class="inp" dir="ltr" autocapitalize="off" spellcheck="false" placeholder="X-API-Key" @bind="_editing.AuthName" @bind:event="oninput" />
                                        }

                                        <label class="lbl">@L["هدرهای اضافی (هر خط: Name: value)"]</label>
                                        <textarea class="inp" rows="3" dir="ltr" autocapitalize="off" spellcheck="false" placeholder="X-Org: my-team" @bind="_editing.Headers" @bind:event="oninput"></textarea>
                                        <p class="muted small">@L["در مقدار می‌توانید {apiKey} را بنویسید تا با کلید جایگزین شود."]</p>

                                        <label class="lbl">@L["پارامترهای اضافی بدنه (JSON)"]</label>
                                        <textarea class="inp" rows="4" dir="ltr" autocapitalize="off" spellcheck="false" placeholder='{"temperature": 0.7}' @bind="_editing.ExtraBody" @bind:event="oninput"></textarea>
                                        <p class="muted small">@L["این فیلدها به هر درخواست اضافه می‌شوند. مقدار null آن فیلد را حذف می‌کند."]</p>

                                        <label class="lbl">@L["مسیر چت (اختیاری)"]</label>
                                        <input class="inp" dir="ltr" autocapitalize="off" spellcheck="false" placeholder="chat/completions" @bind="_editing.ChatPath" @bind:event="oninput" />

                                        <label class="lbl">@L["مسیر لیست مدل‌ها (اختیاری)"]</label>
                                        <input class="inp" dir="ltr" autocapitalize="off" spellcheck="false" placeholder="models" @bind="_editing.ModelsPath" @bind:event="oninput" />

                                        <label class="lbl">@L["کنترل‌ها (JSON، اختیاری)"]</label>
                                        <textarea class="inp code" rows="4" dir="ltr" autocapitalize="off" spellcheck="false" placeholder='[{"id":"temperature","type":"slider","min":0,"max":2,"step":0.1,"default":"0.7"}]'
                                                  @bind="_editing.Controls" @bind:event="oninput"></textarea>
                                        <p class="muted small">@L["هر کنترل یک فیلد در همین فرم می‌سازد (slider, number, select, bool, text). مقدارش را در پارامترهای اضافی بدنه با {{input.id}} بنویسید."]</p>
                                        <div class="row"><button class="btn sm" type="button" @onclick="InsertControlsSample">@L["درج نمونه (temperature و max_tokens)"]</button>
                                            <button class="btn sm" type="button" @onclick="() => _editing.Controls = string.Empty">@L["پاک کردن"]</button></div>
                                        @foreach (var inp in ConnectorSpec.ControlInputs(_editing.Controls))
                                        {
                                            @if (inp.Type != "bool") { <label class="lbl">@L[inp.Label]</label> }
                                            @InputField(inp)
                                        }

                                        @if (_editing.Type == ProviderType.OpenAiCompatible)
                                        {
                                            <label class="chk"><input type="checkbox" @bind="_editing.NoStream" /> @L["پاسخ یکجا (بدون استریم)"]</label>
                                        }
                                    </details>
                                }

                                @if (_editing.Type == ProviderType.Custom)
                                {
                                    <div class="img-opts">
                                        <label class="lbl">@L["اتصال سفارشی"]</label>
                                        <p class="muted small">@L["رفتار API با یک فایل JSON توصیف می‌شود: آدرس‌ها، بدنه‌ی درخواست، و محل نتیجه در پاسخ. با یک الگو شروع کنید و ویرایشش کنید."]</p>

                                        <AppSelect Title="@L["الگوی اتصال"]" Value="" ValueChanged="OnTemplateChosen" Placeholder="@L["— شروع از یک الگو —"]"
                                                   Options="@(ConnectorTemplates.All.Select(t => new AppSelect.SelectOption(t.Name, L[t.Name])).ToList())" />
                                        <div class="row">
                                            <button class="btn sm" type="button" @onclick="() => OpenDlg(1)">❓ @L["راهنما و پرامپت هوش مصنوعی"]</button>
                                        </div>
                                        @if (ConnectorHelp() is { Length: > 0 } help)
                                        {
                                            <p class="muted small" dir="ltr">ℹ @help</p>
                                        }

                                        <textarea class="inp code" rows="16" dir="ltr" autocapitalize="off" spellcheck="false"
                                                  @bind="_editing.ConnectorJson" @bind:event="oninput"></textarea>

                                        <div class="row">
                                            <button class="btn" type="button" @onclick="CheckConnector">@L["بررسی"]</button>
                                            <button class="btn" type="button" @onclick="ImportConnector">@L["وارد کردن فایل JSON"]</button>
                                            <button class="btn" type="button" @onclick="ExportConnector">@L["ذخیره به‌صورت فایل"]</button>
                                            <button class="btn" type="button" @onclick="() => { _editing.ConnectorJson = string.Empty; _editing.ConnectorInputs = new(); }">@L["پاک کردن"]</button>
                                        </div>

                                        @foreach (var inp in ConnectorSpec.Inputs(_editing.ConnectorJson))
                                        {
                                            @if (inp.Type != "bool") { <label class="lbl">@L[inp.Label]</label> }
                                            @InputField(inp)
                                        }
                                    </div>
                                }

                                <label class="lbl">@L["مدل‌ها (هر خط یک مدل)"]</label>
                                <textarea class="inp" rows="6" dir="ltr" autocapitalize="off" spellcheck="false" @bind="_modelsText" @bind:event="oninput"></textarea>

                                <div class="row">
                                    <button class="btn" disabled="@_busy" @onclick="FetchModels">@L["دریافت خودکار لیست مدل‌ها"]</button>
                                </div>

                                <label class="lbl">@L["مدل پیش‌فرض"]</label>
                                <input class="inp" dir="ltr" autocapitalize="off" spellcheck="false" @bind="_editing.DefaultModel" @bind:event="oninput" />

                                @if (_status != null)
                                {
                                    <p class="status" dir="auto">@_status</p>
                                }

                                <div class="row end">
                                    @if (!_isNew)
                                    {
                                        @if (_confirmDelete)
                                        {
                                            <button class="btn danger" @onclick="DeleteProvider">@L["حذف قطعی"]</button>
                                        }
                                        else
                                        {
                                            <button class="btn" @onclick="() => _confirmDelete = true">@L["حذف"]</button>
                                        }
                                    }
                                    <button class="primary" @onclick="Save">@L["ذخیره"]</button>
                                </div>
                            }
                            break;

                        case "chat":
                            <label class="lbl first">@L["پیام سیستمی (اختیاری، برای همه مدل‌ها)"]</label>
                            <textarea class="inp" rows="6" dir="auto" placeholder="@L["مثلاً: همیشه به فارسی پاسخ بده."]"
                                      value="@State.SystemPrompt" @oninput="OnSystemPromptInput"></textarea>
                            <p class="muted small" style="margin-top:8px">@L["دستورالعمل‌های هر پروژه به این پیام اضافه می‌شود."]</p>

                            <label class="lbl">@L["محدودیت حجم فایل‌ها (مگابایت)"]</label>
                            <div class="limits">
                                <label>@L["عکس"] <input class="inp" type="number" min="1" max="500" value="@State.LimitImageMb" @onchange="e => State.SetLimits(imageMb: ToInt(e))" /></label>
                                <label>@L["PDF"] <input class="inp" type="number" min="1" max="500" value="@State.LimitPdfMb" @onchange="e => State.SetLimits(pdfMb: ToInt(e))" /></label>
                                <label>@L["متن و کد"] <input class="inp" type="number" min="1" max="100" value="@State.LimitTextMb" @onchange="e => State.SetLimits(textMb: ToInt(e))" /></label>
                            </div>
                            <label class="chk"><input type="checkbox" checked="@State.ShrinkImages" @onchange="e => State.SetLimits(shrink: (bool)(e.Value ?? false))" /> @L["کوچک‌کردن خودکار عکس‌های بزرگ (بیش از ۳ مگابایت)"]</label>
                            <p class="muted small">@L["بعضی سرویس‌ها (مثل Claude) عکس بزرگ‌تر از ۵ مگابایت را نمی‌پذیرند؛ کوچک‌کردن خودکار آن را به حدود ۲۰۴۸ پیکسل (JPEG) می‌رساند."]</p>

                            <label class="lbl">@L["میانبرها (دستورهای /)"]</label>
                            <p class="muted small">@L["با نوشتن / در ابتدای پیام، میانبرها پیشنهاد می‌شوند. {{text}} جای متن بعد از دستور را می‌گیرد."]</p>
                            <textarea class="inp code" rows="10" dir="ltr" autocapitalize="off" spellcheck="false"
                                      value="@ScText" @oninput="e => { _scText = e.Value?.ToString() ?? string.Empty; _scStatus = null; }"></textarea>
                            <div class="row">
                                <button class="primary" type="button" @onclick="SaveShortcuts">@L["ذخیره"]</button>
                                <button class="btn" type="button" @onclick="InsertShortcutSample">@L["درج نمونه"]</button>
                                <button class="btn" type="button" @onclick="ImportShortcuts">@L["وارد کردن فایل JSON"]</button>
                                <button class="btn" type="button" @onclick="ExportShortcuts">@L["ذخیره به‌صورت فایل"]</button>
                                <button class="btn" type="button" @onclick="ClearShortcuts">@L["پاک کردن"]</button>
                            </div>
                            @if (_scStatus != null)
                            {
                                <p class="status" dir="auto">@_scStatus</p>
                            }
                            break;

                        case "data":
                            <label class="lbl first">@L["لاگ برنامه"]</label>
                            <p class="muted small">@L["اگر برنامه خطا داد، لاگ را کپی کنید و بفرستید. کلید API و متن پیام‌ها در لاگ نمی‌آید."]</p>
                            <button class="btn" @onclick="State.OpenLogs">@L["مشاهده لاگ‌ها"]</button>

                            <label class="lbl">@L["نسخه پشتیبان"]</label>
                            <p class="muted small">@L["همه گفتگوها، پروژه‌ها، API ها، الگوها و فایل‌های پیوست در یک فایل zip ذخیره می‌شود."]</p>
                            <label class="check"><input type="checkbox" checked="@_bkKeys" @onchange="e => _bkKeys = e.Value is true" /> @L["کلیدهای API هم در فایل باشد (فایل را به کسی ندهید)"]</label>
                            <div class="row-btns">
                                <button class="btn" @onclick="MakeBackup">@L["ساخت نسخه پشتیبان"]</button>
                                @if (_bkRestore)
                                {
                                    <button class="btn danger" @onclick="RestoreBackup">@L["مطمئنید؟ اطلاعات فعلی جایگزین می‌شود"]</button>
                                }
                                else
                                {
                                    <button class="btn" @onclick="() => _bkRestore = true">@L["بازیابی از نسخه پشتیبان"]</button>
                                }
                            </div>
                            @if (_bkStatus != null)
                            {
                                <p class="status" dir="auto">@_bkStatus</p>
                            }

                            <label class="lbl">@L["گفتگوها"]</label>
                            @if (_confirmClear)
                            {
                                <button class="btn danger" @onclick="ClearAll">@L["مطمئنید؟ همه گفتگوها پاک می‌شود"]</button>
                            }
                            else
                            {
                                <button class="btn" @onclick="() => _confirmClear = true">@L["پاک کردن همه گفتگوها"]</button>
                            }
                            break;

                        case "about":
                            <label class="lbl first">AI Chat</label>
                            <p>@L["نسخه"] @AppInfo.Current.VersionString</p>
                            <p class="muted small">@L["چت چندسرویسی با پشتیبانی از OpenAI-compatible، Claude و Gemini."]</p>
                            break;
                    }
                </div>
            }
        </div>
    </div>
</div>

@if (_dlg == 0)
{
    <div class="modal-backdrop" @onclick="CloseDlg">
        <div class="sheet wide" @onclick:stopPropagation="true">
            <div class="sheet-head">
                <strong>★ @L["الگوهای من"]</strong>
                <button class="icon-btn sm" title="@L["بستن"]" @onclick="CloseDlg">✕</button>
            </div>
            <div class="tpl-list">
                @foreach (var up in State.UserPresets)
                {
                    var n = up.Name;
                    <div class="tpl-row">
                        <div class="tpl-name"><b dir="auto">@n</b><span class="muted small">@ProviderDefaults.TypeLabel(up.Type)</span></div>
                        <button class="btn sm" type="button" @onclick="() => UsePreset(n)">@L["استفاده"]</button>
                        <button class="btn sm danger" type="button" @onclick="() => State.DeleteUserPresetAsync(n)">@L["حذف"]</button>
                    </div>
                }
                @if (State.UserPresets.Count == 0)
                {
                    <p class="muted">@L["هنوز الگویی ذخیره نکرده‌اید."]</p>
                }
            </div>
        </div>
    </div>
}
else if (_dlg == 1)
{
    <div class="modal-backdrop" @onclick="CloseDlg">
        <div class="sheet wide help-sheet" @onclick:stopPropagation="true">
            <div class="sheet-head">
                <strong>❓ @L["اتصال سفارشی چیست؟"]</strong>
                <button class="icon-btn sm" title="@L["بستن"]" @onclick="CloseDlg">✕</button>
            </div>
            <div class="help-body">
                <p><b>@L["کاربرد"]</b><br />@L["با اتصال سفارشی می‌توانید هر API را به برنامه وصل کنید: چت، تصویر، ویدیو، صوت، سه‌بعدی و غیره. رفتار API در یک فایل JSON توصیف می‌شود، پس برای سرویس تازه نیازی به به‌روزرسانی برنامه نیست."]</p>
                <p><b>@L["چطور کار می‌کند"]</b><br />@L["پیامی که می‌نویسید به‌جای {{prompt}} در درخواست قرار می‌گیرد، درخواست به آدرس API فرستاده می‌شود و JSON می‌گوید نتیجه (متن، تصویر، ویدیو...) کجای پاسخ است. نتیجه داخل چت نمایش داده یا پخش می‌شود."]</p>
                <p><b>@L["سه راه برای ساخت اتصال"]</b></p>
                <ol>
                    <li>@L["از «الگوی اتصال» یکی از الگوهای آماده را بردارید و ویرایش کنید."]</li>
                    <li>@L["یک فایل JSON آماده را با «وارد کردن فایل JSON» اضافه کنید."]</li>
                    <li>@L["پرامپت زیر را همراه مستندات یا مثال درخواست API خود برای یک هوش مصنوعی (ChatGPT، Claude، Gemini...) بفرستید و JSON تحویلی را در ویرایشگر بچسبانید."]</li>
                </ol>
                <p class="muted small">@L["بعد از ساخت، با «ذخیره به‌عنوان الگو» آن را نگه دارید تا دفعه‌ی بعد در لیست باشد. راهنمای کامل قالب در فایل docs/CONNECTORS.md پروژه است."]</p>

                <label class="lbl">@L["پرامپت برای هوش مصنوعی"]</label>
                <textarea class="inp code" rows="12" dir="ltr" readonly>@ConnectorGuide.AiPrompt</textarea>
                <div class="row">
                    <button class="primary" type="button" @onclick="CopyPrompt">@L["کپی پرامپت"]</button>
                    @if (_promptCopied) { <span class="muted">@L["کپی شد ✓"]</span> }
                </div>
            </div>
        </div>
    </div>
}

@code {
    int _dlg = -1;
    bool _promptCopied;

    void OpenDlg(int which)
    {
        _dlg = which;
        _promptCopied = false;
        State.PushBack(CloseDlgFromBack);
    }

    void CloseDlgFromBack()
    {
        _dlg = -1;
        InvokeAsync(StateHasChanged);
    }

    void CloseDlg()
    {
        _dlg = -1;
        State.RemoveBack(CloseDlgFromBack);
    }

    void UsePreset(string name)
    {
        OnPresetChosen("user:" + name);
        CloseDlg();
    }

    async Task CopyPrompt()
    {
        await Clipboard.Default.SetTextAsync(ConnectorGuide.AiPrompt);
        _promptCopied = true;
    }

    /// <summary>The "_help" sentence of the connector in the editor (templates describe themselves there).</summary>
    string ConnectorHelp() =>
        _editing != null && ConnectorSpec.TryParse(_editing.ConnectorJson, out _) is { } o ? JPath.Text(o["_help"]) : "";

    record SectionItem(string Key, string Title);

    SectionItem[] Sections => new[]
    {
        new SectionItem("general", L["عمومی"]),
        new SectionItem("appearance", L["ظاهر"]),
        new SectionItem("api", L["API ها"]),
        new SectionItem("chat", L["گفتگو"]),
        new SectionItem("data", L["داده‌ها و لاگ"]),
        new SectionItem("about", L["درباره"])
    };

    // on a wide window a section is always selected; on a phone null = the list of sections
    string? Section => State.SettingsSection ?? (State.IsNarrow ? null : "general");

    string Title => Section == null
        ? L["تنظیمات"]
        : Sections.First(x => x.Key == Section).Title;

    void Back() => State.SetSettingsSection(null);

    // ---------------- general / chat / data

    void OnSystemPromptInput(ChangeEventArgs e) => State.SetSystemPrompt(e.Value?.ToString() ?? string.Empty);

    void OnRtlChanged(ChangeEventArgs e) => State.SetRtl(e.Value is true);

    static int ToInt(ChangeEventArgs e) => int.TryParse(e.Value?.ToString(), out var v) ? v : 0;
    void OnFullWidth(ChangeEventArgs e) => State.SetUi(width: e.Value is true ? 0 : 768);



    bool _bkKeys, _bkRestore;
    string? _bkStatus;

    async Task MakeBackup()
    {
        _bkStatus = null;
        await State.CreateBackupAsync(_bkKeys);
    }

    async Task RestoreBackup()
    {
        _bkRestore = false;
        try
        {
            var file = await FilePicker.Default.PickAsync(new PickOptions { PickerTitle = L["انتخاب فایل نسخه پشتیبان"] });
            if (file == null) return;
            await using var stream = await file.OpenReadAsync();
            var err = await State.RestoreBackupAsync(stream);
            _bkStatus = err ?? L["بازیابی انجام شد ✓"];
        }
        catch (Exception ex) { _bkStatus = L["خطا: "] + ex.Message; }
    }

    bool _confirmClear;

    async Task ClearAll()
    {
        _confirmClear = false;
        await State.ClearAllConversationsAsync();
    }

    // ---------------- API providers

    ProviderConfig? _editing;
    bool _isNew;
    string _modelsText = "";
    bool _showKey;
    bool _busy;
    bool _confirmDelete;
    string? _status;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (State.EditProviderId != null)
        {
            var wanted = State.Providers.FirstOrDefault(p => p.Id == State.EditProviderId);
            State.EditProviderId = null;
            if (wanted != null) Edit(wanted); else StartNew();
        }
        else if (State.NewApiRequested) { State.NewApiRequested = false; StartNew(); }
        else if (State.Providers.Count == 0) StartNew();
        else Edit(State.CurrentProvider ?? State.Providers[0]);
    }

    void Edit(ProviderConfig p)
    {
        _editing = p.Clone();
        _isNew = false;
        _modelsText = string.Join("\n", p.Models);
        _status = null;
        _showKey = false;
        _confirmDelete = false;
    }

    void StartNew()
    {
        _editing = new ProviderConfig
        {
            Name = "OpenAI",
            Type = ProviderType.OpenAiCompatible,
            BaseUrl = ProviderDefaults.BaseUrl(ProviderType.OpenAiCompatible)
        };
        _isNew = true;
        _modelsText = "";
        _status = null;
        _showKey = false;
        _confirmDelete = false;
    }

    static readonly string[] AspectRatios =
    {
        "704*1408", "704*1344", "768*1344", "768*1280", "832*1216", "832*1152", "896*1152", "896*1088", "960*1088", "960*1024",
        "1024*1024", "1024*960", "1088*960", "1088*896", "1152*896", "1152*832", "1216*832", "1280*768", "1344*768", "1344*704",
        "1408*704", "1472*704", "1536*640", "1600*640", "1664*576", "1728*576"
    };

    void OnFontChosen(string v) => State.SetUi(font: v);

    void OnTypeChosen(string v)
    {
        if (_editing == null || !Enum.TryParse<ProviderType>(v, out var t)) return;
        _editing.Type = t;
        OnTypeChanged();
    }

    List<AppSelect.SelectOption> PresetOptions() =>
        State.UserPresets.Select(u => new AppSelect.SelectOption("user:" + u.Name, "★ " + u.Name))
            .Concat(ProviderDefaults.Presets.Select(pr => new AppSelect.SelectOption(pr.Name, L[pr.Name])))
            .ToList();

    async Task SaveAsPreset()
    {
        if (_editing == null) return;
        if (string.IsNullOrWhiteSpace(_editing.Name)) { _status = L["اول یک نام برای این API بنویسید."]; return; }
        ApplyModelsText();
        await State.SaveUserPresetAsync(_editing, _editing.Name);
        _status = L["الگو ذخیره شد ✓"];
    }

    void ApplyModelsText() =>
        _editing!.Models = _modelsText.Split('\n').Select(x => x.Trim()).Where(x => x.Length > 0).Distinct().ToList();

    void OnPresetChosen(string name)
    {
        if (name.StartsWith("user:") && _editing != null)
        {
            var up = State.UserPresets.FirstOrDefault(u => u.Name == name[5..]);
            if (up == null) return;
            var c = up.Clone();
            c.Id = _editing.Id;
            c.ApiKey = _editing.ApiKey;
            _editing = c;
            _modelsText = string.Join("\n", c.Models);
            _status = L["الگو بارگذاری شد؛ در صورت نیاز آدرس و کلید را تنظیم کنید."];
            return;
        }
        var preset = ProviderDefaults.Presets.FirstOrDefault(p => p.Name == name);
        if (preset == null || _editing == null) return;
        _editing.Name = L[preset.Name];
        _editing.Type = preset.Type;
        _editing.BaseUrl = preset.BaseUrl;
    }

    void OnTypeChanged()
    {
        if (_editing == null) return;
        // switching type: if the URL is still one of the known defaults, swap it for the new type's default
        var known = ProviderDefaults.Presets.Select(p => p.BaseUrl)
            .Concat(new[] { "https://api.openai.com/v1", "https://api.anthropic.com/v1", "https://generativelanguage.googleapis.com/v1beta" });
        if (string.IsNullOrWhiteSpace(_editing.BaseUrl) || known.Contains(_editing.BaseUrl.Trim()))
            _editing.BaseUrl = ProviderDefaults.BaseUrl(_editing.Type);
    }

    bool _advOpen;

    static string Inv(double d) => d.ToString(System.Globalization.CultureInfo.InvariantCulture);

    RenderFragment<ConnInput> InputField => inp => @<div>
        @if (inp.Type == "select" && inp.Options.Count > 0)
        {
            <AppSelect Title="@L[inp.Label]" Value="@InputOf(inp.Id, inp.Default)" ValueChanged="v => _editing!.ConnectorInputs[inp.Id] = v"
                       Options="@(inp.Options.Select(o => new AppSelect.SelectOption(o, o)).ToList())" />
        }
        else if (inp.Type == "bool")
        {
            <label class="chk"><input type="checkbox" checked="@(InputOf(inp.Id, inp.Default).Equals("true", StringComparison.OrdinalIgnoreCase))"
                                      @onchange="e => _editing!.ConnectorInputs[inp.Id] = ((bool)(e.Value ?? false)).ToString().ToLowerInvariant()" /> @L[inp.Label]</label>
        }
        else if (inp.Type == "slider")
        {
            <div class="slider-row">
                <input type="range" class="range" min="@Inv(inp.Min ?? 0)" max="@Inv(inp.Max ?? 1)" step="@Inv(inp.Step ?? 0.1)"
                       value="@InputOf(inp.Id, inp.Default)" @oninput="e => _editing!.ConnectorInputs[inp.Id] = e.Value?.ToString() ?? string.Empty" />
                <span class="muted val" dir="ltr">@InputOf(inp.Id, inp.Default)</span>
            </div>
        }
        else
        {
            <input class="inp" dir="auto" type="@(inp.Type == "number" ? "number" : "text")" step="any"
                   value="@InputOf(inp.Id, inp.Default)" @oninput="e => _editing!.ConnectorInputs[inp.Id] = e.Value?.ToString() ?? string.Empty" />
        }
    </div>;

    void InsertControlsSample()
    {
        if (_editing == null) return;
        _editing.Controls = "[\n" +
            "  { \"id\": \"temperature\", \"label\": \"Temperature\", \"type\": \"slider\", \"min\": 0, \"max\": 2, \"step\": 0.1, \"default\": \"0.7\" },\n" +
            "  { \"id\": \"max_tokens\", \"label\": \"Max tokens\", \"type\": \"number\", \"default\": \"1024\" }\n" +
            "]";
        if (string.IsNullOrWhiteSpace(_editing.ExtraBody))
            _editing.ExtraBody = "{ \"temperature\": \"{{input.temperature}}\", \"max_tokens\": \"{{input.max_tokens}}\" }";
        _advOpen = true;
    }

    // ---- slash shortcuts (chat section)
    string? _scText;
    string? _scStatus;

    string ScText => _scText ??= State.ShortcutsJson;

    void SaveShortcuts()
    {
        var err = State.SetShortcutsJson(ScText);
        _scStatus = err == null ? L["ذخیره شد ✓"] : L["خطا: "] + err;
    }

    void ClearShortcuts() { _scText = string.Empty; _scStatus = null; }

    void InsertShortcutSample() { _scText = ShortcutHelper.Sample; _scStatus = null; }

    async Task ImportShortcuts()
    {
        try
        {
            var file = await FilePicker.Default.PickAsync(new PickOptions { PickerTitle = L["انتخاب فایل JSON میانبرها"] });
            if (file == null) return;
            await using var stream = await file.OpenReadAsync();
            using var reader = new StreamReader(stream);
            _scText = await reader.ReadToEndAsync();
            SaveShortcuts();
        }
        catch (Exception ex) { _scStatus = L["خطا: "] + ex.Message; }
    }

    Task ExportShortcuts() => State.SaveTextAsync("shortcuts.json", ScText);

    string InputOf(string id, string def) => _editing != null && _editing.ConnectorInputs.TryGetValue(id, out var v) ? v : def;

    void OnTemplateChosen(string name)
    {
        var t = ConnectorTemplates.All.FirstOrDefault(x => x.Name == name);
        if (t == null || _editing == null) return;
        _editing.ConnectorJson = t.Json.Trim();
        _editing.ConnectorInputs = new();
        _editing.BaseUrl = t.BaseUrl;
        if (_isNew || string.IsNullOrWhiteSpace(_editing.Name) || _editing.Name == "OpenAI") _editing.Name = L[t.Name];
        _modelsText = "";
        _status = L["الگو بارگذاری شد؛ در صورت نیاز آدرس و کلید را تنظیم کنید."];
    }

    void CheckConnector()
    {
        if (_editing == null) return;
        var err = ConnectorSpec.Validate(_editing.ConnectorJson);
        _status = err == null ? L["اتصال معتبر به نظر می‌رسد ✓"] : L["خطا در اتصال: "] + err;
    }

    async Task ImportConnector()
    {
        if (_editing == null) return;
        try
        {
            var file = await FilePicker.Default.PickAsync(new PickOptions { PickerTitle = L["انتخاب فایل JSON اتصال"] });
            if (file == null) return;
            await using var stream = await file.OpenReadAsync();
            using var reader = new StreamReader(stream);
            _editing.ConnectorJson = await reader.ReadToEndAsync();
            _editing.ConnectorInputs = new();
            CheckConnector();
        }
        catch (Exception ex)
        {
            _status = L["خطا: "] + ex.Message;
        }
    }

    Task ExportConnector()
    {
        if (_editing == null) return Task.CompletedTask;
        var name = string.Concat((_editing.Name ?? "connector").Select(c => char.IsLetterOrDigit(c) ? c : '-')).Trim('-');
        return State.SaveTextAsync((name.Length == 0 ? "connector" : name) + ".json", _editing.ConnectorJson ?? "");
    }

    static readonly (string Key, string Label)[] AuthModes =
    {
        ("default", "پیش‌فرض (بر اساس نوع API)"),
        ("bearer", "Bearer در هدر Authorization"),
        ("header", "هدر دلخواه"),
        ("query", "پارامتر در آدرس (query)"),
        ("none", "بدون کلید"),
    };

    string? ValidateAdvanced()
    {
        if (_editing == null) return null;
        try
        {
            if (!string.IsNullOrWhiteSpace(_editing.ExtraBody) &&
                System.Text.Json.Nodes.JsonNode.Parse(_editing.ExtraBody) is not System.Text.Json.Nodes.JsonObject)
                return L["پارامترهای اضافی باید یک شیء JSON باشد."];
        }
        catch (Exception ex)
        {
            return L["JSON پارامترهای اضافی نامعتبر است: "] + ex.Message;
        }
        try
        {
            if (!string.IsNullOrWhiteSpace(_editing.Controls) &&
                System.Text.Json.Nodes.JsonNode.Parse(_editing.Controls) is not System.Text.Json.Nodes.JsonArray)
                return L["کنترل‌ها باید یک آرایه‌ی JSON باشد."];
        }
        catch (Exception ex)
        {
            return L["JSON کنترل‌ها نامعتبر است: "] + ex.Message;
        }
        try { ProviderHttp.ParseHeaders(_editing.Headers ?? "", "x"); }
        catch (Exception ex) { return L["هدرها نامعتبر است: "] + ex.Message; }
        if (_editing.AuthMode is "header" or "query" && string.IsNullOrWhiteSpace(_editing.AuthName))
            return L["نام هدر یا پارامتر کلید را وارد کنید."];
        return null;
    }

    Task FetchModels() => TryFetch();

    async Task<bool> TryFetch()
    {
        if (_editing == null) return false;
        if (string.IsNullOrWhiteSpace(_editing.BaseUrl))
            _editing.BaseUrl = ProviderDefaults.BaseUrl(_editing.Type);

        _busy = true;
        _status = L["در حال دریافت..."];
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
            var list = await State.FetchModelsAsync(_editing, cts.Token);
            _modelsText = string.Join("\n", list);
            if (string.IsNullOrWhiteSpace(_editing.DefaultModel) && list.Count > 0)
                _editing.DefaultModel = list[0];
            _status = L.F("{0} مدل دریافت شد. برای نگه‌داشتن، ذخیره را بزنید.", list.Count);
            return list.Count > 0;
        }
        catch (Exception ex)
        {
            _status = L["خطا: "] + ProviderHttp.Describe(ex);
            return false;
        }
        finally
        {
            _busy = false;
        }
    }

    async Task Save()
    {
        if (_editing == null) return;
        if (string.IsNullOrWhiteSpace(_editing.Name))
        {
            _status = L["نام را وارد کنید."];
            return;
        }

        if (_editing.Type == ProviderType.Custom && ConnectorSpec.Validate(_editing.ConnectorJson) is { } connErr)
        {
            _status = L["خطا در اتصال: "] + connErr;
            return;
        }
        if (ValidateAdvanced() is { } advErr) { _status = advErr; _advOpen = true; return; }

        _editing.Name = _editing.Name.Trim();
        _editing.ApiKey = (_editing.ApiKey ?? "").Trim();
        _editing.DefaultModel = (_editing.DefaultModel ?? "").Trim();
        if (string.IsNullOrWhiteSpace(_editing.BaseUrl))
            _editing.BaseUrl = ProviderDefaults.BaseUrl(_editing.Type);
        _editing.BaseUrl = _editing.BaseUrl.Trim();

        // no model list yet: fetch it automatically (the manual button stays available)
        var autoFetched = false;
        string? fetchError = null;
        if (string.IsNullOrWhiteSpace(_modelsText))
        {
            autoFetched = await TryFetch();
            if (!autoFetched) fetchError = _status;
        }

        _editing.Models = _modelsText
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct()
            .ToList();
        if (string.IsNullOrWhiteSpace(_editing.DefaultModel) && _editing.Models.Count > 0)
            _editing.DefaultModel = _editing.Models[0];

        await State.SaveProviderAsync(_editing);
        _isNew = false;
        _status = L["ذخیره شد ✓"];
        if (autoFetched) _status += " · " + L.F("{0} مدل دریافت شد.", _editing.Models.Count);
        else if (fetchError != null) _status += " · " + L["دریافت خودکار مدل‌ها ناموفق بود"] + " (" + fetchError + ")";
    }

    async Task DeleteProvider()
    {
        if (_editing == null) return;
        await State.DeleteProviderAsync(_editing.Id);
        _confirmDelete = false;
        if (State.Providers.Count == 0) StartNew();
        else Edit(State.Providers[0]);
    }
}
