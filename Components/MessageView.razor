@using Microsoft.Maui.ApplicationModel.DataTransfer
@inject ChatState State

<div class="msg @Message.Role" id="m-@Index" data-idx="@Index">
    @if (Message.Role == "user")
    {
        <div class="user-wrap">
            @if (Message.Attachments.Count > 0)
            {
                <div class="att-row">
                    @foreach (var a in Message.Attachments)
                    {
                        <AttachmentChip @key="a" Attachment="a" />
                    }
                </div>
            }
            @if (_editing)
            {
                <div class="edit-box">
                    <textarea class="inp" dir="auto" rows="@Math.Clamp(_editText.Split('\n').Length + 1, 3, 12)"
                              @bind="_editText" @bind:event="oninput"></textarea>
                    <div class="edit-actions">
                        <button class="btn" @onclick="CancelEdit">انصراف</button>
                        <button class="primary" @onclick="SaveEdit">ارسال</button>
                    </div>
                </div>
            }
            else
            {
                @if (!string.IsNullOrEmpty(Message.Content))
                {
                    <div class="user-bubble" dir="auto">@Message.Content</div>
                }

                @if (!State.IsStreaming)
                {
                    <div class="user-actions">
                        @if (Message.Versions is { Count: > 1 })
                        {
                            <div class="ver-nav" dir="ltr">
                                <button class="icon-btn sm" title="نسخه قبلی" disabled="@(Message.VersionIndex <= 0)" @onclick="() => Switch(-1)">
                                    <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m15 6-6 6 6 6" /></svg>
                                </button>
                                <span>@(Message.VersionIndex + 1) / @Message.Versions.Count</span>
                                <button class="icon-btn sm" title="نسخه بعدی" disabled="@(Message.VersionIndex >= Message.Versions.Count - 1)" @onclick="() => Switch(1)">
                                    <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6" /></svg>
                                </button>
                            </div>
                        }
                        <button class="icon-btn sm" title="ویرایش پیام" @onclick="StartEdit">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
                        </button>
                    </div>
                }
            }
        </div>
    }
    else
    {
        <div class="assistant-row">
            <div class="avatar">AI</div>
            <div class="assistant-body">
                @if (string.IsNullOrEmpty(Message.Content) && Streaming && Message.ErrorText == null)
                {
                    <div class="typing"><i></i><i></i><i></i></div>
                }
                else if (!string.IsNullOrEmpty(Message.Content))
                {
                    <div class="md">@((MarkupString)Message.Html)</div>
                }

                @if (Message.Attachments.Count > 0)
                {
                    <div class="att-row start">
                        @foreach (var a in Message.Attachments)
                        {
                            <AttachmentChip @key="a" Attachment="a" />
                        }
                    </div>
                }

                @if (Message.ErrorText != null)
                {
                    <div class="error-box" dir="auto">⚠️ @Message.ErrorText</div>
                }

                @if (!Streaming)
                {
                    <div class="actions">
                        @if (!string.IsNullOrEmpty(Message.Content))
                        {
                            <button class="icon-btn sm" title="کپی" @onclick="CopyAsync">
                                @if (_copied)
                                {
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7" /></svg>
                                }
                                else
                                {
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2" /><path d="M5 15V6a2 2 0 0 1 2-2h9" /></svg>
                                }
                            </button>
                        }
                        @if (!string.IsNullOrEmpty(Message.Content))
                        {
                            <button class="icon-btn sm" title="ذخیره پاسخ به‌صورت فایل (.md)" @onclick="SaveAnswer">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11" /><path d="m7 11 5 5 5-5" /><path d="M5 20h14" /></svg>
                            </button>
                        }
                        @if (IsLast)
                        {
                            <button class="icon-btn sm" title="تولید مجدد" @onclick="() => State.RegenerateAsync()">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7L21 8" /><path d="M21 3v5h-5" /></svg>
                            </button>
                        }
                        @if (!string.IsNullOrEmpty(Message.Model))
                        {
                            <span class="model-tag" dir="ltr">@Message.Model</span>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public ChatMessage Message { get; set; } = default!;
    [Parameter] public int Index { get; set; }
    [Parameter] public bool IsLast { get; set; }
    [Parameter] public bool Streaming { get; set; }

    bool _copied;
    bool _editing;
    string _editText = string.Empty;

    void StartEdit()
    {
        _editText = Message.Content;
        _editing = true;
    }

    void CancelEdit() => _editing = false;

    async Task SaveEdit()
    {
        _editing = false;
        await State.EditAndResendAsync(Message, _editText);
    }

    Task Switch(int delta) => State.SwitchVersionAsync(Message, delta);

    Task SaveAnswer() => State.SaveTextAsync("answer.md", Message.Content);

    async Task CopyAsync()
    {
        await Clipboard.Default.SetTextAsync(Message.Content);
        _copied = true;
        StateHasChanged();
        await Task.Delay(1500);
        _copied = false;
        StateHasChanged();
    }
}
