@inherits StateComponent

<aside class="sidebar @(State.SidebarOpen == true ? "open" : "")">
    <div class="sb-top">
        <button class="new-chat" @onclick="State.NewChat">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
            <span>گفتگوی جدید</span>
        </button>
    </div>

    <div class="sb-list">
        @if (State.Conversations.Count == 0)
        {
            <div class="sb-empty muted">هنوز گفتگویی ندارید</div>
        }
        @foreach (var c in State.Conversations)
        {
            var conv = c;
            <div class="conv @(conv == State.Active ? "active" : "")" @onclick="() => State.OpenConversation(conv)">
                <span class="title" dir="auto">@conv.Title</span>
                @if (_confirmId == conv.Id)
                {
                    <button class="del confirm" @onclick="() => Delete(conv)" @onclick:stopPropagation="true">حذف؟</button>
                }
                else
                {
                    <button class="del" title="حذف" @onclick="() => _confirmId = conv.Id" @onclick:stopPropagation="true">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14" /></svg>
                    </button>
                }
            </div>
        }
    </div>

    <div class="sb-bottom">
        <button class="settings-btn" @onclick="State.OpenSettings">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z" /></svg>
            <span>تنظیمات و API ها</span>
        </button>
    </div>
</aside>

@code {
    string? _confirmId;

    async Task Delete(Conversation c)
    {
        _confirmId = null;
        await State.DeleteConversationAsync(c);
    }
}
