@inherits StateComponent

<aside class="sidebar @(State.SidebarOpen == true ? "open" : "")">
    <div class="sb-top">
        <button class="new-chat" @onclick="State.NewChat">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
            <span>@L["گفتگوی جدید"]</span>
        </button>
    </div>

    <div class="sb-search">
        <div class="sb-search-box">
            <svg class="muted" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
            <input dir="auto" placeholder="@L["جست‌وجو در گفتگوها..."]" value="@_query" @oninput="OnQueryInput" @onkeydown="OnQueryKey" />
            @if (_query.Length > 0)
            {
                <button class="del vis" title="@L["پاک کردن"]" @onclick="ClearQuery">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18" /></svg>
                </button>
            }
        </div>
        <div class="seg">
            <button class="@(!State.SidebarSearchInContent ? "on" : "")" @onclick="() => State.SetSidebarSearchInContent(false)">@L["نام گفتگوها"]</button>
            <button class="@(State.SidebarSearchInContent ? "on" : "")" @onclick="() => State.SetSidebarSearchInContent(true)">@L["متن گفتگوها"]</button>
        </div>
    </div>

    <div class="sb-list">
        @if (Searching)
        {
            var hits = State.SearchConversations(_query, State.SidebarSearchInContent);
            if (hits.Count == 0)
            {
                <div class="sb-empty muted">@L["نتیجه‌ای پیدا نشد"]</div>
            }
            else
            {
                <div class="sb-section">@(hits.Count) @L["گفتگو"]</div>
            }
            foreach (var hit in hits)
            {
                var h = hit;
                <div class="conv hit @(h.Conv == State.Active ? "active" : "")" @onclick="() => OpenHit(h)">
                    <div class="hit-main">
                        <span class="title" dir="auto">@h.Conv.Title</span>
                        @if (State.SidebarSearchInContent && h.Count > 0)
                        {
                            <span class="badge" title="@L["تعداد دفعات پیدا شدن"]">@h.Count</span>
                        }
                    </div>
                    @if (h.Match != null)
                    {
                        <div class="snippet" dir="auto">@(h.Before)<mark>@(h.Match)</mark>@(h.After)</div>
                    }
                </div>
            }
        }
        else
        {
        foreach (var row in BuildRows())
        {
            if (row.Kind == "projhead")
            {
                <div class="sb-section with-action">
                    <span>@L["پروژه‌ها"]</span>
                    <button class="del vis" title="@L["پروژه جدید"]" @onclick="NewProject">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                    </button>
                </div>
                continue;
            }

            if (row.Kind == "header")
            {
                <div class="sb-section">@row.Text</div>
                continue;
            }

            if (row.Kind == "project")
            {
                var proj = row.Proj!;
                var open = _expanded.Contains(proj.Id);
                <div class="conv project @(open ? "open" : "")" @onclick="() => ToggleProject(proj)">
                    <svg class="folder" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" /></svg>
                    <span class="title" dir="auto">@proj.Name</span>
                    @if (_confirmProjId == proj.Id)
                    {
                        <button class="del confirm" @onclick="() => DeleteProject(proj)" @onclick:stopPropagation="true">@L["حذف پروژه؟"]</button>
                    }
                    else
                    {
                        <button class="del" title="@L["گزینه‌ها"]" @onclick="e => OpenProjMenu(proj, e)" @onclick:stopPropagation="true">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="1.8" /><circle cx="12" cy="12" r="1.8" /><circle cx="19" cy="12" r="1.8" /></svg>
                        </button>
                    }
                    <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                </div>
                continue;
            }

            var conv = row.Conv!;
            <div class="conv @(conv == State.Active ? "active" : "") @(row.Indent ? "indent" : "")" @onclick="() => State.OpenConversation(conv)">
                @if (_renamingId == conv.Id)
                {
                    <input class="rename-input" dir="auto" maxlength="80" @ref="_renameInput"
                           @bind="_renameText" @bind:event="oninput"
                           @onkeydown="OnRenameKey" @onblur="CommitRename"
                           @onclick:stopPropagation="true" />
                }
                else
                {
                    if (conv.Pinned)
                    {
                        <svg class="pin-mark" width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M16 3H8v2l1 1v6l-3 3v2h5v5h2v-5h5v-2l-3-3V6l1-1Z" /></svg>
                    }
                    <span class="title" dir="auto" title="@L["برای تغییر نام دوبار کلیک کنید"]"
                          @ondblclick="() => StartRename(conv)">@conv.Title</span>
                    @if (_confirmId == conv.Id)
                    {
                        <button class="del confirm" @onclick="() => Delete(conv)" @onclick:stopPropagation="true">@L["حذف؟"]</button>
                    }
                    else
                    {
                        <button class="del" title="@L["گزینه‌ها"]" @onclick="e => OpenMenu(conv, e)" @onclick:stopPropagation="true">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="1.8" /><circle cx="12" cy="12" r="1.8" /><circle cx="19" cy="12" r="1.8" /></svg>
                        </button>
                    }
                }
            </div>
        }

        @if (State.Conversations.Count == 0)
        {
            <div class="sb-empty muted">@L["هنوز گفتگویی ندارید"]</div>
        }
        }
    </div>

    @if (_menuConv != null)
    {
        <div class="menu-backdrop" @onclick="CloseMenu" @onclick:stopPropagation="true"></div>
        <div class="menu" style="top:min(@(_menuY)px, calc(100dvh - 260px)); left:min(@(_menuX)px, calc(100vw - 210px))" @onclick:stopPropagation="true">
            <button @onclick="PinFromMenu">@(_menuConv.Pinned ? L["برداشتن پین"] : L["پین کردن"])</button>
            <button @onclick="RenameFromMenu">@L["تغییر نام"]</button>
            @if (State.Projects.Count > 0 || _menuConv.ProjectId != null)
            {
                <button @onclick="() => _moveOpen = !_moveOpen">@L["انتقال به پروژه ‹"]</button>
                @if (_moveOpen)
                {
                    <div class="submenu">
                        @foreach (var p in State.Projects)
                        {
                            var target = p;
                            <button class="@(_menuConv.ProjectId == target.Id ? "current" : "")" dir="auto" @onclick="() => MoveTo(target.Id)">📁 @target.Name</button>
                        }
                        @if (_menuConv.ProjectId != null)
                        {
                            <button @onclick="() => MoveTo(null)">@L["بدون پروژه"]</button>
                        }
                    </div>
                }
            }
            <button class="danger" @onclick="DeleteFromMenu">@L["حذف"]</button>
        </div>
    }

    @if (_menuProj != null)
    {
        <div class="menu-backdrop" @onclick="CloseMenu" @onclick:stopPropagation="true"></div>
        <div class="menu" style="top:min(@(_menuY)px, calc(100dvh - 200px)); left:min(@(_menuX)px, calc(100vw - 210px))" @onclick:stopPropagation="true">
            <button @onclick="NewChatInProjectFromMenu">@L["گفتگوی جدید در این پروژه"]</button>
            <button @onclick="EditProjectFromMenu">@L["ویرایش پروژه (دستورالعمل و فایل‌ها)"]</button>
            <button class="danger" @onclick="DeleteProjectFromMenu">@L["حذف پروژه"]</button>
        </div>
    }

    <div class="sb-bottom">
        <button class="settings-btn" @onclick="State.OpenSettings">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z" /></svg>
            <span>@L["تنظیمات و API ها"]</span>
        </button>
    </div>
</aside>

@code {
    // ---- search ----

    string _query = string.Empty;

    bool Searching => _query.Trim().Length > 0;

    void OnQueryInput(ChangeEventArgs e) => _query = e.Value?.ToString() ?? string.Empty;

    void OnQueryKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _query = string.Empty;
    }

    void ClearQuery() => _query = string.Empty;

    void OpenHit(ChatState.SearchHit hit)
    {
        // content search: open the chat with the in-chat search bar already filled in
        if (State.SidebarSearchInContent && hit.Count > 0) State.OpenConversationWithSearch(hit.Conv, _query.Trim());
        else State.OpenConversation(hit.Conv);
    }

    // ---- rows ----

    record Row(string Kind, string? Text = null, Conversation? Conv = null, Project? Proj = null, bool Indent = false);

    readonly HashSet<string> _expanded = new();

    List<Row> BuildRows()
    {
        var rows = new List<Row> { new("projhead") };

        foreach (var p in State.Projects)
        {
            rows.Add(new Row("project", Proj: p));
            if (_expanded.Contains(p.Id))
                rows.AddRange(State.Conversations
                    .Where(c => c.ProjectId == p.Id && !c.Pinned)
                    .Select(c => new Row("conv", Conv: c, Indent: true)));
        }

        var pinned = State.Conversations.Where(c => c.Pinned).ToList();
        var others = State.Conversations.Where(c => !c.Pinned && State.ProjectOf(c) == null).ToList();

        if (pinned.Count > 0)
        {
            rows.Add(new Row("header", L["پین‌شده"]));
            rows.AddRange(pinned.Select(c => new Row("conv", Conv: c)));
        }
        if (others.Count > 0)
        {
            rows.Add(new Row("header", L["گفتگوها"]));
            rows.AddRange(others.Select(c => new Row("conv", Conv: c)));
        }
        return rows;
    }

    void ToggleProject(Project p)
    {
        if (!_expanded.Remove(p.Id)) _expanded.Add(p.Id);
    }

    void NewProject() => State.OpenProjectDialog(null);

    // ---- menus ----

    Conversation? _menuConv;
    Project? _menuProj;
    bool _moveOpen;
    int _menuX, _menuY;

    void OpenMenu(Conversation c, MouseEventArgs e)
    {
        _confirmId = null;
        _confirmProjId = null;
        _moveOpen = false;
        _menuProj = null;
        _menuConv = c;
        _menuX = (int)e.ClientX;
        _menuY = (int)e.ClientY;
    }

    void OpenProjMenu(Project p, MouseEventArgs e)
    {
        _confirmId = null;
        _confirmProjId = null;
        _menuConv = null;
        _menuProj = p;
        _menuX = (int)e.ClientX;
        _menuY = (int)e.ClientY;
    }

    void CloseMenu()
    {
        _menuConv = null;
        _menuProj = null;
        _moveOpen = false;
    }

    async Task PinFromMenu()
    {
        var c = _menuConv;
        CloseMenu();
        if (c != null) await State.TogglePinAsync(c);
    }

    void RenameFromMenu()
    {
        var c = _menuConv;
        CloseMenu();
        if (c != null) StartRename(c);
    }

    void DeleteFromMenu()
    {
        _confirmId = _menuConv?.Id;
        CloseMenu();
    }

    async Task MoveTo(string? projectId)
    {
        var c = _menuConv;
        CloseMenu();
        if (c == null) return;
        await State.MoveConversationAsync(c, projectId);
        if (projectId != null) _expanded.Add(projectId);
    }

    void NewChatInProjectFromMenu()
    {
        var p = _menuProj;
        CloseMenu();
        if (p == null) return;
        _expanded.Add(p.Id);
        State.NewChatInProject(p.Id);
    }

    void EditProjectFromMenu()
    {
        var p = _menuProj;
        CloseMenu();
        if (p != null) State.OpenProjectDialog(p);
    }

    void DeleteProjectFromMenu()
    {
        _confirmProjId = _menuProj?.Id;
        CloseMenu();
    }

    async Task DeleteProject(Project p)
    {
        _confirmProjId = null;
        await State.DeleteProjectAsync(p);
    }

    // ---- delete / rename ----

    string? _confirmId;
    string? _confirmProjId;
    string? _renamingId;
    string _renameText = string.Empty;
    bool _focusRename;
    bool _cancelRename;
    ElementReference _renameInput;

    void StartRename(Conversation c)
    {
        _confirmId = null;
        _renamingId = c.Id;
        _renameText = c.Title;
        _cancelRename = false;
        _focusRename = true;
    }

    async Task OnRenameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await CommitRename();
        }
        else if (e.Key == "Escape")
        {
            _cancelRename = true;
            _renamingId = null;
        }
    }

    async Task CommitRename()
    {
        var id = _renamingId;
        if (id == null) return; // already finished (Enter pressed, then blur fired)
        _renamingId = null;

        if (_cancelRename) return;
        var conv = State.Conversations.FirstOrDefault(x => x.Id == id);
        if (conv != null) await State.RenameConversationAsync(conv, _renameText);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusRename && _renamingId != null)
        {
            _focusRename = false;
            await _renameInput.FocusAsync();
        }
    }

    async Task Delete(Conversation c)
    {
        _confirmId = null;
        await State.DeleteConversationAsync(c);
    }
}
