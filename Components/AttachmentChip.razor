@inject ChatState State

@if (Attachment.Kind == "image")
{
    <div class="att-img">
        @if (Attachment.DataUri != null)
        {
            <img src="@Attachment.DataUri" alt="@Attachment.Name" title="@Attachment.Name" />
        }
        else
        {
            <div class="att-loading"></div>
        }
        @if (Removable)
        {
            <button class="att-x" title="حذف" @onclick="OnRemove">×</button>
        }
    </div>
}
else
{
    <div class="att-file" title="@Attachment.Name">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z" /><path d="M14 3v5h5" /></svg>
        <span class="att-meta">
            <span class="att-name" dir="auto">@Attachment.Name</span>
            <small class="muted">@Attachment.SizeText</small>
        </span>
        @if (Removable)
        {
            <button class="att-x inline" title="حذف" @onclick="OnRemove">×</button>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public Attachment Attachment { get; set; } = default!;
    [Parameter] public bool Removable { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (Attachment.Kind == "image" && Attachment.DataUri == null)
        {
            var bytes = await State.ReadAttachmentAsync(Attachment);
            if (bytes != null)
                Attachment.DataUri = $"data:{Attachment.MimeType};base64,{Convert.ToBase64String(bytes)}";
        }
    }
}
