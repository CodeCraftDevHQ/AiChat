@inject ChatState State
@inject IJSRuntime JS
@implements IDisposable

@if (Attachment.Kind == "image")
{
    <div class="att-img @(Attachment.Excluded ? "excluded" : "")" title="@ImgTitle" @onclick="OpenImage">
        @if (Attachment.DataUri != null)
        {
            <img src="@Attachment.DataUri" alt="@Attachment.Name" />
        }
        else
        {
            <div class="att-loading"></div>
        }
        @if (Removable)
        {
            <button class="att-x" title="@L["حذف"]" @onclick="OnRemove" @onclick:stopPropagation="true">×</button>
        }
        @if (CanReuse && Attachment.DataUri != null)
        {
            <button class="att-use" title="@L["استفاده در پیام بعدی"]" @onclick="Reuse" @onclick:stopPropagation="true">↪</button>
        }
        @if (Attachment.Seed != null)
        {
            <button class="att-seed" title="@L.F("استفاده از Seed {0}", Attachment.Seed)" @onclick="UseSeed" @onclick:stopPropagation="true">🎲</button>
        }
    </div>
}
else if (Attachment.Kind is "video" or "audio" && !Removable)
{
    <div class="att-media @Attachment.Kind">
        @if (_tooBig)
        {
            <div class="muted small">@L["فایل برای پخش در برنامه بزرگ است؛ آن را ذخیره کنید."]</div>
        }
        else if (Attachment.Kind == "video")
        {
            <video @ref="_media" controls preload="metadata" playsinline></video>
            @if (!Removable)
            {
                <div class="att-vctl">
                    <button class="btn sm" type="button" title="@L["۱۰ ثانیه عقب"]" @onclick="() => Skip(-10)">⏪ 10</button>
                    <button class="btn sm" type="button" title="@L["۱۰ ثانیه جلو"]" @onclick="() => Skip(10)">10 ⏩</button>
                    <button class="btn sm" type="button" title="@L["سرعت پخش"]" @onclick="CycleRate">@(_rate.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))×</button>
                    <button class="btn sm @(_loop ? "on" : "")" type="button" title="@L["تکرار"]" @onclick="ToggleLoop">🔁</button>
                    <button class="btn sm" type="button" title="@L["گرفتن این فریم به‌صورت عکس"]" @onclick="CaptureFrame">📷</button>
                    <button class="btn sm" type="button" title="@L["تصویر در تصویر"]" @onclick="Pip">⧉</button>
                    <button class="btn sm" type="button" title="@L["تمام‌صفحه"]" @onclick="Fullscreen">⛶</button>
                </div>
            }
        }
        else
        {
            <audio @ref="_media" controls preload="metadata"></audio>
        }
        <div class="att-media-bar">
            <span class="att-name" dir="auto">@Attachment.Name</span>
            <small class="muted">@Attachment.SizeText</small>
            <button class="btn sm" type="button" @onclick="SaveFile">⬇ @L["ذخیره"]</button>
        </div>
    </div>
}
else
{
    <div class="att-file @(Attachment.Excluded ? "excluded" : "")" title="@FileTitle" @onclick="SaveFile">
        @if (Removable && Attachment.Kind is "video" or "audio")
        {
            <span>@(Attachment.Kind == "video" ? "🎬" : "🎵")</span>
        }
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z" /><path d="M14 3v5h5" /></svg>
        <span class="att-meta">
            <span class="att-name" dir="auto">@Attachment.Name</span>
            <small class="muted">@Attachment.SizeText</small>
        </span>
        @if (Removable)
        {
            <button class="att-x inline" title="@L["حذف"]" @onclick="OnRemove" @onclick:stopPropagation="true">×</button>
        }
    </div>
}

@code {
    string ImgTitle => (Attachment.Excluded ? L["ارسال نمی‌شود (مدل عکس را پشتیبانی نمی‌کند)"] + ": " : "") + Attachment.Name;
    string FileTitle => L["برای ذخیره کلیک کنید"] + ": " + Attachment.Name;

    [Parameter, EditorRequired] public Attachment Attachment { get; set; } = default!;
    [Parameter] public bool Removable { get; set; }
    [Parameter] public bool CanReuse { get; set; }

    Task Reuse() => State.UseAsInputAsync(Attachment);

    // ---- video controls
    static readonly double[] Rates = { 0.5, 0.75, 1, 1.25, 1.5, 2 };
    double _rate = 1;
    bool _loop;

    async Task Js(string fn, params object?[] args)
    {
        try { await JS.InvokeVoidAsync(fn, args); } catch { }
    }

    Task Skip(int seconds) => Js("chat.mediaSkip", _media, seconds);
    Task Pip() => Js("chat.mediaPip", _media);
    Task Fullscreen() => Js("chat.mediaFull", _media);

    async Task CycleRate()
    {
        var i = Array.FindIndex(Rates, r => Math.Abs(r - _rate) < 0.001);
        _rate = Rates[(i + 1) % Rates.Length];
        await Js("chat.mediaRate", _media, _rate);
    }

    async Task ToggleLoop()
    {
        _loop = !_loop;
        await Js("chat.mediaLoop", _media, _loop);
    }

    /// <summary>The picture at the current time becomes an image attachment of the next message (to ask about it, edit it, ...).</summary>
    async Task CaptureFrame()
    {
        try
        {
            var b64 = await JS.InvokeAsync<string?>("chat.mediaFrame", _media);
            if (string.IsNullOrEmpty(b64)) { State.SetNotice(L["گرفتن فریم ممکن نشد."]); return; }
            using var stream = new MemoryStream(Convert.FromBase64String(b64));
            var err = await State.AddAttachmentAsync("frame-" + DateTime.Now.ToString("HHmmss") + ".png", stream);
            if (err != null) State.SetNotice(err); else State.ViewerToast(L["فریم به پیام بعدی اضافه شد ✓"]);
        }
        catch (Exception ex) { State.SetNotice(ex.Message); }
    }
    Task UseSeed() => State.UseSeedAsync(Attachment);
    [Parameter] public EventCallback OnRemove { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (Attachment.Kind == "image" && Attachment.DataUri == null)
        {
            var bytes = await State.ReadAttachmentAsync(Attachment);
            if (bytes != null)
                Attachment.DataUri = $"data:{Attachment.MimeType};base64,{Convert.ToBase64String(bytes)}";
        }
    }

    void OpenImage()
    {
        if (Attachment.DataUri != null)
            State.OpenViewer(Attachment.DataUri, Attachment.Name, Attachment);
    }

    Task SaveFile() => State.SaveAttachmentAsync(Attachment);

    ElementReference _media;
    bool _tooBig, _mediaLoaded;
    const long MaxPlayableBytes = 150L * 1024 * 1024;

    protected override void OnParametersSet()
    {
        _tooBig = Attachment.Kind is "video" or "audio" && Attachment.Size > MaxPlayableBytes;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_mediaLoaded || _tooBig || Attachment.Kind is not ("video" or "audio")) return;
        _mediaLoaded = true;
        try
        {
            var bytes = await State.ReadAttachmentAsync(Attachment);
            if (bytes == null) return;
            using var stream = new MemoryStream(bytes);
            await JS.InvokeVoidAsync("chat.attachMedia", _media, new DotNetStreamReference(stream), Attachment.MimeType);
        }
        catch
        {
            // the player stays empty; the save button still works
        }
    }

    public void Dispose()
    {
        if (!_mediaLoaded) return;
        try { _ = JS.InvokeVoidAsync("chat.releaseMedia", _media).AsTask().ContinueWith(_ => { }); } catch { }
    }
}
