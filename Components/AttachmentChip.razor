@inject ChatState State

@if (Attachment.Kind == "image")
{
    <div class="att-img @(Attachment.Excluded ? "excluded" : "")" title="@ImgTitle" @onclick="OpenImage">
        @if (Attachment.DataUri != null)
        {
            <img src="@Attachment.DataUri" alt="@Attachment.Name" />
        }
        else
        {
            <div class="att-loading"></div>
        }
        @if (Removable)
        {
            <button class="att-x" title="@L["حذف"]" @onclick="OnRemove" @onclick:stopPropagation="true">×</button>
        }
    </div>
}
else
{
    <div class="att-file @(Attachment.Excluded ? "excluded" : "")" title="@FileTitle" @onclick="SaveFile">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z" /><path d="M14 3v5h5" /></svg>
        <span class="att-meta">
            <span class="att-name" dir="auto">@Attachment.Name</span>
            <small class="muted">@Attachment.SizeText</small>
        </span>
        @if (Removable)
        {
            <button class="att-x inline" title="@L["حذف"]" @onclick="OnRemove" @onclick:stopPropagation="true">×</button>
        }
    </div>
}

@code {
    string ImgTitle => (Attachment.Excluded ? L["ارسال نمی‌شود (مدل عکس را پشتیبانی نمی‌کند)"] + ": " : "") + Attachment.Name;
    string FileTitle => L["برای ذخیره کلیک کنید"] + ": " + Attachment.Name;

    [Parameter, EditorRequired] public Attachment Attachment { get; set; } = default!;
    [Parameter] public bool Removable { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (Attachment.Kind == "image" && Attachment.DataUri == null)
        {
            var bytes = await State.ReadAttachmentAsync(Attachment);
            if (bytes != null)
                Attachment.DataUri = $"data:{Attachment.MimeType};base64,{Convert.ToBase64String(bytes)}";
        }
    }

    void OpenImage()
    {
        if (Attachment.DataUri != null)
            State.OpenViewer(Attachment.DataUri, Attachment.Name, Attachment);
    }

    Task SaveFile() => State.SaveAttachmentAsync(Attachment);
}
