        else if (key == "ArrowLeft") await State.ViewerStepAsync((L.Language == "fa") ? 1 : -1);
        else if (key == "ArrowRight") await State.ViewerStepAsync((L.Language == "fa") ? -1 : 1);
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!ReferenceEquals(_viewerShown, State.Viewer))
        {
            _viewerShown = State.Viewer;
            if (State.Viewer != null && _self != null)
                try { await JS.InvokeVoidAsync("chat.viewerInit", _self); } catch { }
        }

        if (!firstRender && _ctxLang != null && _ctxLang != L.Language)
        {
            _ctxLang = L.Language;
            await JS.InvokeVoidAsync("chat.setCtxLabels", CtxLabels());
        }

        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("chat.initComposer", _input, _self);
            State.PlayAudioBytes = async (bytes, mime, ct) =>
            {
                using var reg = ct.Register(() => _ = JS.InvokeVoidAsync("chat.stopAudio"));
                await JS.InvokeVoidAsync("chat.playAudio", Convert.ToBase64String(bytes), mime);
                ct.ThrowIfCancellationRequested();
            };
            State.StopAudioBytes = async () => await JS.InvokeVoidAsync("chat.stopAudio");
            await JS.InvokeVoidAsync("chat.initDrop", _self);
            await JS.InvokeVoidAsync("chat.initRail", _self);
            await JS.InvokeVoidAsync("chat.initContextMenu", _self, CtxLabels());
            _ctxLang = L.Language;

            // Android back button: close the top-most layer first, only then leave the app
            BackNavigation.Handler = () => State.HandleBack();
            var narrow = await JS.InvokeAsync<bool>("chat.isNarrow");
            State.SetNarrow(narrow);
        }

        if (State.TakeComposerText() is { } composerText)
            await JS.InvokeVoidAsync("chat.setValue", _input, composerText);

        await SyncSearchBarAsync();

        if (_appliedLang != State.Language)
        {
            _appliedLang = State.Language;
            await JS.InvokeVoidAsync("chat.setLang", State.Language);
        }

        if (_appliedUi != State.UiSignature)
        {
            _appliedUi = State.UiSignature;
            await JS.InvokeVoidAsync("chat.setUi", State.UiFontSize, State.UiWidth, State.UiLineHeight, State.UiFont);
        }

        if (_appliedStyle != State.StyleSignature)
        {
            _appliedStyle = State.StyleSignature;
            await JS.InvokeVoidAsync("chat.setStyle", _appliedStyle);
        }

        if (_appliedKeys != State.KeysSignature)
        {
            _appliedKeys = State.KeysSignature;
            await JS.InvokeVoidAsync("chat.setKeys", _appliedKeys);
        }

        if (_appliedTheme != State.Theme)
        {
            _appliedTheme = State.Theme;
            await JS.InvokeVoidAsync("chat.setTheme", State.Theme);
        }

        var count = State.Active?.Messages.Count ?? 0;
        var force = count != _lastCount || !ReferenceEquals(State.Active, _lastActive);
        _lastCount = count;
        _lastActive = State.Active;

        if (State.IsStreaming || force)
            await JS.InvokeVoidAsync("chat.scroll", "messages", force);
    }

