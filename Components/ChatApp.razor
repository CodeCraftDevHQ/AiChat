@inherits StateComponent
@using Microsoft.Maui.Storage
@inject IJSRuntime JS
@inject LogService Log

<div class="app" dir="@(State.IsRtl ? "rtl" : "ltr")">

    <Sidebar />
    <div class="scrim @(State.SidebarOpen == true ? "show" : "")" @onclick="State.CloseSidebar"></div>

    <main class="main">
        @if (State.PdfPrompt != null)
        {
            <div class="modal-backdrop" @onclick='() => State.ChoosePdfMode("text")'>
                <div class="sheet pdf-choice" @onclick:stopPropagation="true">
                    <div class="sheet-head"><strong>📄 @State.PdfPrompt.Name</strong></div>
                    <div class="pdf-body">
                        <p>@L["PDF چگونه ارسال شود؟"]</p>
                        <button class="btn pdf-opt" @onclick='() => State.ChoosePdfMode("text")'>
                            <b>@L["ارسال متن استخراج‌شده"]</b>
                            <small>@L["با همه‌ی سرویس‌ها کار می‌کند. تصویر و جدول‌ها دیده نمی‌شوند."]</small>
                        </button>
                        <button class="btn pdf-opt" @onclick='() => State.ChoosePdfMode("file")'>
                            <b>@L["ارسال خود فایل PDF"]</b>
                            <small>@L["فقط Claude و Gemini؛ در سرویس‌های دیگر به‌جایش متن فرستاده می‌شود. مدل صفحه‌ها را هم می‌بیند."]</small>
                        </button>
                        @if (State.PdfPromptTruncated)
                        {
                            <p class="pdf-warn">⚠ @L["متن این PDF خیلی طولانی است و در حالت متن، بخش آخر آن بریده می‌شود."]</p>
                        }
                    </div>
                </div>
            </div>
        }

        @if (State.Picker != null)
        {
            var isModel = State.Picker == "model";
            var items = isModel
                ? State.ModelsFor(State.CurrentProvider)
                    .Where(m => m.Contains(State.PickerFilter, StringComparison.OrdinalIgnoreCase))
                    .Where(m => !State.OnlyWorkingModels || State.TestResultOf(m)?.Ok == true).ToList()
                : State.Providers.Select(p => p.Id).ToList();
            <div class="modal-backdrop" @onclick="State.ClosePicker">
                <div class="sheet" @onclick:stopPropagation="true">
                    <div class="sheet-head">
                        <strong>@(isModel ? L["مدل"] : L["سرویس‌دهنده"])</strong>
                        <button class="icon-btn sm" title="@L["بستن"]" @onclick="State.ClosePicker">✕</button>
                    </div>
                    @if (isModel && State.ModelsFor(State.CurrentProvider).Count > 8)
                    {
                        <input class="inp sheet-search" dir="auto" placeholder="@L["جست‌وجوی مدل..."]" value="@State.PickerFilter" @oninput="OnPickerFilter" />
                    }
                    @if (isModel)
                    {
                        <div class="sheet-tools">
                            @if (State.TestingModels)
                            {
                                <span class="muted" dir="ltr">@State.TestDone / @State.TestTotal</span>
                                <button class="btn sm" @onclick="State.StopModelTest">@L["توقف"]</button>
                            }
                            else
                            {
                                <button class="btn sm" title="@L["هر مدل یک پیام کوتاه می‌گیرد (هزینه‌ی ناچیز)"]" @onclick="() => State.TestModelsAsync(items)">🧪 @L["تست مدل‌ها"]</button>
                            }
                            @if (State.TestMessage != null)
                            {
                                <span class="pdf-warn">⏳ @State.TestMessage</span>
                            }
                            @if (items.Count > 0 || State.OnlyWorkingModels)
                            {
                                <label class="check small">
                                    <input type="checkbox" checked="@State.OnlyWorkingModels" @onchange="e => { State.OnlyWorkingModels = e.Value is true; State.SetPickerFilter(State.PickerFilter); }" />
                                    <span>@L["فقط مدل‌های کارا"]</span>
                                </label>
                            }
                        </div>
                    }
                    <div class="sheet-list">
                        @if (items.Count == 0)
                        {
                            <div class="sheet-empty">@L["نتیجه‌ای پیدا نشد"]</div>
                        }
                        @foreach (var id in items)
                        {
                            var value = id;
                            var label = isModel ? value : State.Providers.First(p => p.Id == value).Name;
                            var current = isModel ? value == State.CurrentModel : value == State.CurrentProviderId;
                            var test = isModel ? State.TestResultOf(value) : null;
                            <button class="sheet-item @(current ? "current" : "") @(test is { Ok: false } ? "failed" : "")" dir="auto" title="@(test?.Error ?? "")" @onclick="() => PickItem(value)">
                                <span>@(test == null ? "" : test.Ok ? "✅ " : test.RateLimited ? "⏳ " : "❌ ")@label</span>@if (current) { <span>✓</span> }
                            </button>
                        }
                        @if (!isModel)
                        {
                            <button class="sheet-item add" @onclick="State.OpenNewApi">+ @L["افزودن API"]</button>
                        }
                    </div>
                </div>
            </div>
        }

        <header class="topbar">
            <button class="icon-btn" title="@L["منو"]" @onclick="State.ToggleSidebar">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            </button>

            <div class="pickers">
                @if (State.Providers.Count == 0)
                {
                    <button class="chip" @onclick="OpenApiSettings">@L["+ افزودن API"]</button>
                }
                else
                {
                    <button class="picker" title="@L["سرویس‌دهنده"]" @onclick='() => State.OpenPicker("provider")'>@State.CurrentProvider?.Name <span class="caret">▾</span></button>
                    <button class="picker model" title="@L["مدل"]" @onclick='() => State.OpenPicker("model")'>@(string.IsNullOrWhiteSpace(State.CurrentModel) ? L["— مدل —"] : State.CurrentModel) <span class="caret">▾</span></button>
                }
            </div>

            @if (State.Active != null && State.Active.Messages.Count > 0)
            {
                <button class="icon-btn" title="@L["جست‌وجو در گفتگو (Ctrl+F)"]" @onclick="State.OpenSearch">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                </button>
            }

            <button class="icon-btn" title="@L["تغییر تم تاریک/روشن"]" @onclick="ToggleTheme">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
            </button>

            <button class="icon-btn" title="@L["گفتگوی جدید"]" @onclick="State.NewChat">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
            </button>
        </header>

        @if (State.SearchOpen)
        {
            <div class="searchbar">
                <svg class="muted" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                <input class="search-input" dir="auto" @ref="_searchInput" value="@_searchText"
                       placeholder="@L["جست‌وجو در این گفتگو..."]" @oninput="OnSearchInput" @onkeydown="OnSearchKey" />
                <span class="search-count muted" dir="ltr">@SearchCounter</span>
                <button class="icon-btn sm" title="@L["قدیمی‌تر"]" disabled="@(_searchTotal == 0)" @onclick="() => SearchStep(-1)">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 15 6-6 6 6" /></svg>
                </button>
                <button class="icon-btn sm" title="@L["جدیدتر"]" disabled="@(_searchTotal == 0)" @onclick="() => SearchStep(1)">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                </button>
                <button class="icon-btn sm" title="@L["بستن"]" @onclick="State.CloseSearch">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18" /></svg>
                </button>
            </div>
        }

        <div id="messages" class="messages @(Questions.Count >= 2 ? "has-rail" : "")">
            @if (State.Active == null || State.Active.Messages.Count == 0)
            {
                <div class="welcome">
                    <div class="logo">AI</div>
                    <h1>@L["امروز چه کمکی از من برمی‌آید؟"]</h1>
                    @if (State.CurrentProject != null)
                    {
                        <p class="project-tag" dir="auto">📁 @(L["پروژه"]): @State.CurrentProject.Name</p>
                    }
                    @if (State.Providers.Count == 0)
                    {
                        <p class="muted">@L["برای شروع، کلید API سرویس مورد نظرتان را اضافه کنید."]</p>
                        <button class="primary" @onclick="OpenApiSettings">@L["افزودن API"]</button>
                    }
                    else
                    {
                        <p class="muted" dir="ltr">@State.CurrentProvider?.Name · @State.CurrentModel</p>
                    }
                </div>
            }
            else
            {
                var msgs = State.Active.Messages;
                <div class="thread">
                    @for (var i = 0; i < msgs.Count; i++)
                    {
                        var last = i == msgs.Count - 1;
                        <MessageView @key="msgs[i]" Message="msgs[i]" Index="i" IsLast="last" Streaming="@(State.IsStreaming && last)" />
                    }
                </div>
            }
        </div>

        @if (Questions.Count >= 2)
        {
            <div class="qrail @(_railOpen ? "open" : "")" @onmouseleave="CloseRail">
                <div class="qpanel">
                    @foreach (var q in Questions)
                    {
                        var qi = q.Index;
                        <button class="qitem @(qi == _activeQ ? "active" : "")" @onclick="() => GoToQuestion(qi)">
                            <span class="qtext" dir="auto">@q.Text</span>
                            <i class="qdash"></i>
                        </button>
                    }
                </div>
                <button class="qdashes" title="@L["سوال‌های شما"]" @onclick="ToggleRail">
                    @foreach (var q in Questions)
                    {
                        <i class="qd @(q.Index == _activeQ ? "active" : "")"></i>
                    }
                </button>
            </div>
        }

        <div class="composer">
            @if (!_atBottom && State.Active != null && State.Active.Messages.Count > 0)
            {
                <button class="to-bottom" title="@L["رفتن به آخر گفتگو"]" @onclick="ScrollToBottom">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                </button>
            }
            @if (State.Notice != null)
            {
                <div class="notice" @onclick="State.ClearNotice">@State.Notice</div>
            }
            @if (State.Pending.Count > 0)
            {
                <div class="att-row pending">
                    @foreach (var a in State.Pending)
                    {
                        var att = a;
                        <AttachmentChip @key="att" Attachment="att" Removable="true" OnRemove="() => State.RemovePending(att)" />
                    }
                </div>
            }
            @if (_plusMenu)
            {
                <div class="menu-backdrop" @onclick="() => _plusMenu = false"></div>
                <div class="menu" style="top:auto; bottom:84px; left:14px; right:auto">
                    <button @onclick="PickFromMenu">📎 @L["فایل یا عکس"]</button>
                    <button @onclick="TakePhoto">📷 @L["دوربین"]</button>
                </div>
            }
            <div class="box">
                @if (IsMobile)
                {
                    <button class="icon-btn attach" title="@L["پیوست عکس یا فایل"]" @onclick="() => _plusMenu = !_plusMenu">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                    </button>
                }
                else
                {
                    <button class="icon-btn attach" title="@L["پیوست عکس یا فایل"]" @onclick="PickFiles">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.4 11.1-9.2 9.2a6 6 0 0 1-8.5-8.5l9.2-9.2a4 4 0 0 1 5.7 5.7l-9.2 9.2a2 2 0 0 1-2.8-2.8l8.5-8.5" /></svg>
                    </button>
                }
                <textarea @ref="_input" rows="1" dir="auto" enterkeyhint="enter" placeholder="@L["هر چیزی بپرسید..."]"></textarea>
                @if (State.IsStreaming)
                {
                    <button class="send" title="@L["توقف"]" @onclick="State.Stop">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><rect x="5" y="5" width="14" height="14" rx="2" /></svg>
                    </button>
                }
                else
                {
                    <button class="send" title="@L["ارسال"]" @onclick="SendClick">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5" /><path d="m5 12 7-7 7 7" /></svg>
                    </button>
                }
            </div>
            <div class="hint">@L["پاسخ‌ها ممکن است اشتباه باشند. اطلاعات مهم را بررسی کنید."]</div>
        </div>
    </main>

    @if (State.Viewer != null)
    {
        <div class="viewer" @onclick="State.CloseViewer">
            <div class="viewer-bar" @onclick:stopPropagation="true">
                <span class="viewer-name" dir="auto">@State.Viewer.Name</span>
                <button class="btn" @onclick="State.SaveViewerAsync">@L["ذخیره / دانلود"]</button>
                <button class="icon-btn" title="@L["بستن"]" @onclick="State.CloseViewer">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18" /></svg>
                </button>
            </div>
            <img class="viewer-img" src="@State.Viewer.Src" alt="@State.Viewer.Name" @onclick:stopPropagation="true" />
        </div>
    }

    @if (State.Toast != null)
    {
        <div class="toast">@State.Toast</div>
    }

    <div class="drop-overlay">
        <div class="drop-box">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4" /><path d="m7 9 5-5 5 5" /><path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3" /></svg>
            <div>@L["فایل یا عکس را اینجا رها کنید"]</div>
            <small class="muted">@L["عکس (png, jpg, gif, webp) و فایل‌های متنی/کد"]</small>
        </div>
    </div>

    @if (State.ShowSettings)
    {
        <SettingsDialog />
    }

    @if (State.ProjectDialogOpen)
    {
        <ProjectDialog />
    }

    @if (State.ShowLogs)
    {
        <LogDialog />
    }
</div>

@code {
    ElementReference _input;
    DotNetObjectReference<ChatApp>? _self;
    int _lastCount;
    Conversation? _lastActive;
    string? _appliedTheme;
    string? _appliedUi;
    string? _appliedLang;

    // ---------------- search in this chat

    ElementReference _searchInput;
    string _searchText = string.Empty;
    int _searchCur, _searchTotal;
    bool _wasSearchOpen;

    string SearchCounter =>
        _searchText.Trim().Length == 0 ? "" : _searchTotal == 0 ? L["بدون نتیجه"] : $"{_searchCur} / {_searchTotal}";

    async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? string.Empty;
        await RunSearch();
    }

    async Task RunSearch()
    {
        var r = await JS.InvokeAsync<int[]>("chat.searchRun", _searchText);
        _searchCur = r[0];
        _searchTotal = r[1];
    }

    async Task SearchStep(int delta)
    {
        var r = await JS.InvokeAsync<int[]>("chat.searchStep", delta);
        _searchCur = r[0];
        _searchTotal = r[1];
    }

    // Enter = older match (like Telegram), Shift+Enter = newer match
    async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchStep(e.ShiftKey ? 1 : -1);
    }

    [JSInvokable]
    public void OnFind()
    {
        if (State.Active != null && State.Active.Messages.Count > 0) State.OpenSearch();
    }

    async Task SyncSearchBarAsync()
    {
        if (State.SearchOpen && !_wasSearchOpen)
        {
            _wasSearchOpen = true;

            // opened from a sidebar search result: start with that text
            if (State.PendingSearch != null)
            {
                _searchText = State.PendingSearch;
                State.PendingSearch = null;
                StateHasChanged();
            }

            await _searchInput.FocusAsync();
            if (_searchText.Length > 0) await RunSearch();
        }
        else if (!State.SearchOpen && _wasSearchOpen)
        {
            _wasSearchOpen = false;
            _searchText = string.Empty;
            _searchCur = _searchTotal = 0;
            await JS.InvokeVoidAsync("chat.searchClear");
            StateHasChanged();
        }
    }

    // ---------------- question rail (jump to a question)

    record Question(int Index, string Text);

    int _activeQ = -1;
    bool _atBottom = true;
    bool _railOpen;

    List<Question> Questions
    {
        get
        {
            var list = new List<Question>();
            var msgs = State.Active?.Messages;
            if (msgs == null) return list;
            for (var i = 0; i < msgs.Count; i++)
                if (msgs[i].Role == "user")
                    list.Add(new Question(i, QuestionText(msgs[i])));
            return list;
        }
    }

    static string QuestionText(ChatMessage m)
    {
        if (!string.IsNullOrWhiteSpace(m.Content))
            return m.Content.Trim().Replace("\n", " ");
        return "📎 " + (m.Attachments.FirstOrDefault()?.Name ?? "…");
    }

    void ToggleRail() => _railOpen = !_railOpen;
    void CloseRail() => _railOpen = false;

    async Task GoToQuestion(int index)
    {
        if (State.IsNarrow) _railOpen = false;
        await JS.InvokeVoidAsync("chat.scrollToMsg", index);
    }

    Task ScrollToBottom() => JS.InvokeVoidAsync("chat.scrollToBottom", "messages").AsTask();

    [JSInvokable]
    public Task OnActiveQuestion(int index) => InvokeAsync(() => { _activeQ = index; StateHasChanged(); });

    [JSInvokable]
    public Task OnAtBottom(bool atBottom) => InvokeAsync(() => { _atBottom = atBottom; StateHasChanged(); });

    void OpenApiSettings() => State.OpenSettingsAt("api");

    async Task ToggleTheme()
    {
        var dark = await JS.InvokeAsync<bool>("chat.isDark");
        State.SetTheme(dark ? "light" : "dark");
    }

    protected override async Task OnInitializedAsync()
    {
        await State.InitAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("chat.initComposer", _input, _self);
            await JS.InvokeVoidAsync("chat.initDrop", _self);
            await JS.InvokeVoidAsync("chat.initRail", _self);

            // Android back button: close the top-most layer first, only then leave the app
            BackNavigation.Handler = () => State.HandleBack();
            var narrow = await JS.InvokeAsync<bool>("chat.isNarrow");
            State.SetNarrow(narrow);
        }

        await SyncSearchBarAsync();

        if (_appliedLang != State.Language)
        {
            _appliedLang = State.Language;
            await JS.InvokeVoidAsync("chat.setLang", State.Language);
        }

        if (_appliedUi != State.UiSignature)
        {
            _appliedUi = State.UiSignature;
            await JS.InvokeVoidAsync("chat.setUi", State.UiFontSize, State.UiWidth, State.UiLineHeight, State.UiFont);
        }

        if (_appliedTheme != State.Theme)
        {
            _appliedTheme = State.Theme;
            await JS.InvokeVoidAsync("chat.setTheme", State.Theme);
        }

        var count = State.Active?.Messages.Count ?? 0;
        var force = count != _lastCount || !ReferenceEquals(State.Active, _lastActive);
        _lastCount = count;
        _lastActive = State.Active;

        if (State.IsStreaming || force)
            await JS.InvokeVoidAsync("chat.scroll", "messages", force);
    }

    void OnPickerFilter(ChangeEventArgs e) => State.SetPickerFilter(e.Value?.ToString() ?? "");

    void PickItem(string value)
    {
        if (State.Picker == "model") State.SelectModel(value);
        else State.SelectProvider(value);
        State.ClosePicker();
    }

    [JSInvokable]
    public Task OnEnter() => InvokeAsync(SendClick);

    // Called from JS for files that were dropped on the window or pasted into the input.
    [JSInvokable]
    public async Task OnFileDropped(string name, string base64)
    {
        try
        {
            var bytes = Convert.FromBase64String(base64);
            using var stream = new MemoryStream(bytes);
            var err = await State.AddAttachmentAsync(name, stream);
            if (err != null) State.SetNotice(err);
        }
        catch (Exception ex)
        {
            State.SetNotice(L["خطا در افزودن فایل: "] + ex.Message);
        }
    }

    // An image inside an answer was clicked.
    [JSInvokable]
    public void OnOpenImage(string src, string alt) => State.OpenViewer(src, string.IsNullOrWhiteSpace(alt) ? "image" : alt);

    // The "save" button of a code block was clicked.
    [JSInvokable]
    public Task OnSaveText(string name, string text) => State.SaveTextAsync(name, text);

    // Esc closes dialogs (desktop)
    [JSInvokable]
    public void OnEscape() => State.HandleBack(includeSidebar: false);

    [JSInvokable]
    public void OnJsError(string message) => Log.Error("JS: " + message);

    [JSInvokable]
    public void OnFileTooBig(string name) =>
        State.SetNotice(L.F("«{0}» بزرگ‌تر از حد مجاز است.", name));

    async Task SendClick()
    {
        if (State.IsStreaming) return;

        var err = State.ValidateSend();
        if (err != null)
        {
            State.SetNotice(err);
            if (State.Providers.Count == 0) State.OpenSettingsAt("api");
            return;
        }

        var text = await JS.InvokeAsync<string>("chat.takeValue", _input);
        if (string.IsNullOrWhiteSpace(text) && State.Pending.Count == 0) return;
        await State.SendAsync(text);
    }

    static async Task<Stream> DownscaleIfImage(string name, Stream stream)
    {
        var ext = Path.GetExtension(name).ToLowerInvariant();
        if (ext is not (".jpg" or ".jpeg")) return stream;
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        return new MemoryStream(PhotoHelper.Downscale(ms.ToArray()));
    }

    async Task<string?> AddPickedAsync(string name, Stream stream)
    {
        await using var s = await DownscaleIfImage(name, stream);
        return await State.AddAttachmentAsync(name, s);
    }

    static bool IsMobile => DeviceInfo.Current.Platform == DevicePlatform.Android || DeviceInfo.Current.Platform == DevicePlatform.iOS;
    bool _plusMenu;

    async Task PickFromMenu()
    {
        _plusMenu = false;
        await PickFiles();
    }

    async Task TakePhoto()
    {
        _plusMenu = false;
        try
        {
            var photo = await PhotoHelper.CapturePhotoAsync();
            if (photo == null) return;
            using var ms = new MemoryStream(photo.Value.Data);
            var err = await State.AddAttachmentAsync(photo.Value.Name, ms);
            if (err != null) State.SetNotice(err);
        }
        catch (Exception ex)
        {
            State.SetNotice(L["خطا در گرفتن عکس: "] + ex.Message);
        }
    }

    async Task PickFiles()
    {
        try
        {
            var files = await FilePicker.Default.PickMultipleAsync(new PickOptions { PickerTitle = L["انتخاب عکس یا فایل"] });
            if (files == null) return;

            foreach (var f in files)
            {
                await using var stream = await f.OpenReadAsync();
                var err = await AddPickedAsync(f.FileName, stream);
                if (err != null) State.SetNotice(err);
            }
        }
        catch (Exception ex)
        {
            State.SetNotice(L["خطا در انتخاب فایل: "] + ex.Message);
        }
    }

    public override void Dispose()
    {
        base.Dispose();
        BackNavigation.Handler = null;
        _self?.Dispose();
    }
}
