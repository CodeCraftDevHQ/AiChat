    List<Shortcut> _slash = new();

    [JSInvokable]
    public Task OnComposerInput(string value) => InvokeAsync(() =>
    {
        var list = value.StartsWith('/')
            ? State.Shortcuts.Where(s => s.Name.StartsWith(value[1..], StringComparison.OrdinalIgnoreCase)).Take(8).ToList()
            : new List<Shortcut>();
        if (list.Count == _slash.Count && list.Select(x => x.Name).SequenceEqual(_slash.Select(x => x.Name))) return;
        _slash = list;
        StateHasChanged();
    });

