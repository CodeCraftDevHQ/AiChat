    const string VoteA = "a", VoteB = "b", VoteBoth = "both", VoteBad = "bad";

    class MicResult { public string Data { get; set; } = ""; public string Mime { get; set; } = ""; }

    async Task MicClick()
    {
        if (State.Transcribing) return;
        if (!State.Recording)
        {
            State.StopSpeak();
            if (DeviceInfo.Platform == DevicePlatform.Android)
            {
                var st = await Permissions.RequestAsync<Permissions.Microphone>();
                if (st != PermissionStatus.Granted) { State.SetNotice(L["اجازه‌ی میکروفون داده نشد."]); return; }
            }
            var err = await JS.InvokeAsync<string>("chat.micStart");
            if (!string.IsNullOrEmpty(err))
            {
                State.SetNotice(L["میکروفون در دسترس نیست یا اجازه داده نشد: "] + err);
                return;
            }
            State.SetRecording(true);
            return;
        }

        State.SetRecording(false);
        var r = await JS.InvokeAsync<MicResult>("chat.micStop");
        if (string.IsNullOrEmpty(r.Data)) return;
        var text = await State.TranscribeAsync(Convert.FromBase64String(r.Data), r.Mime);
        if (string.IsNullOrWhiteSpace(text)) return;
        await JS.InvokeVoidAsync("chat.appendValue", _input, text);
        if (State.VoiceOpts.AutoSend) await SendClick();
    }

