<Project Sdk="Microsoft.NET.Sdk">

	<!-- Plain net10.0 test project: it compiles the MAUI-free source files of the app directly (no MAUI needed). -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<RootNamespace>AiChat.Tests</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
		<PackageReference Include="xunit" Version="2.*" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
		<PackageReference Include="Markdig" Version="0.*" />
		<PackageReference Include="Jint" Version="4.*" />
		<PackageReference Include="PdfPig" Version="0.1.*" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\..\Models\Models.cs" Link="App\Models.cs" />
		<Compile Include="..\..\Services\Connector.cs" Link="App\Connector.cs" />
		<Compile Include="..\..\Services\ConnectorTemplates.cs" Link="App\ConnectorTemplates.cs" />
		<Compile Include="..\..\Services\Providers.cs" Link="App\Providers.cs" />
		<Compile Include="..\..\Services\Shortcuts.cs" Link="App\Shortcuts.cs" />
		<Compile Include="..\..\Services\MarkdownRenderer.cs" Link="App\MarkdownRenderer.cs" />
		<Compile Include="..\..\Services\PdfHelper.cs" Link="App\PdfHelper.cs" />
		<Compile Include="..\..\Services\PinHelper.cs" Link="App\PinHelper.cs" />
		<Compile Include="..\..\Services\WebSearch.cs" Link="App\WebSearch.cs" />
		<Compile Include="..\..\Services\TokenCost.cs" Link="App\TokenCost.cs" />
		<Compile Include="..\..\Services\Tools.cs" Link="App\Tools.cs" />
		<Compile Include="..\..\Services\Mcp.cs" Link="App\Mcp.cs" />
		<Compile Include="..\..\Services\Memory.cs" Link="App\Memory.cs" />
		<Compile Include="..\..\Services\Summary.cs" Link="App\Summary.cs" />
		<Compile Include="..\..\Services\CodeRun.cs" Link="App\CodeRun.cs" />
		<Compile Include="..\..\Services\SearchText.cs" Link="App\SearchText.cs" />
		<Compile Include="..\..\Services\Loc.cs" Link="App\Loc.cs" />
		<Compile Include="..\..\Services\Translations.cs" Link="App\Translations.cs" />
		<Compile Include="..\..\Services\SettingsIndex.cs" Link="App\SettingsIndex.cs" />
		<Compile Include="..\..\Services\SettingsIndex.Items.cs" Link="App\SettingsIndex.Items.cs" />
		<Compile Include="..\..\Services\ConnectorRepo.cs" Link="App\ConnectorRepo.cs" />
	</ItemGroup>

</Project>
